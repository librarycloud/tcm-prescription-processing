<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Release builds require HTTPS. Debug builds opt into cleartext in the manifest. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

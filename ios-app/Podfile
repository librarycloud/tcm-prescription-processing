platform :ios, '18.0'
project 'TCMAdmin/TCMAdmin.xcodeproj'

target 'TCMAdmin' do
  use_frameworks!

  # ONNX Runtime with ObjC API — includes Core ML EP + XNNPACK EP pre-built
  pod 'onnxruntime-objc', '~> 1.24'

  # YAML parsing for model config files
  pod 'Yams', '~> 5.0'

  # OpenCV
  pod 'OpenCV', '~> 4.3.0'

  # JPush (极光推送) — domestic China push notifications
  pod 'JPush', '~> 5.4.0'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '18.0'
      config.build_settings['OTHER_LIBTOOLFLAGS'] = '-no_warning_for_no_symbols'
    end
  end
end

.stats, .processing-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 8rpx;
}

.stat-card, .processing-stat {
  margin-bottom: 0 !important;
}

.stat-value, .processing-value {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.2;
}

.stat-card-disabled {
  opacity: 0.6;
}

.stat-card-active, .processing-stat-active {
  background: #f2f7ff !important;
  border-color: #0052d9 !important;
}

.section-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.section-action-item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  max-width: 100%;
}

.section-action-item > t-button {
  display: inline-block;
  width: 100%;
}

.business-actions {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.business-action-button {
  width: 100% !important;
  min-width: 0 !important;
  max-width: 100% !important;
  box-sizing: border-box;
}

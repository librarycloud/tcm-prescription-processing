<view class="page herb-page">
  <view class="page-heading"><view class="page-heading-main"><view class="page-title">斗谱管理</view><view class="muted store-name">{{storeName || '请选择门店'}}</view></view><view class="page-heading-action"><t-button block t-class="heading-action-button" theme="primary" size="small" bind:tap="openAssignment">配置药材</t-button></view></view>
  <picker wx:if="{{isSuperAdmin}}" mode="selector" range="{{stores}}" range-key="name" value="{{storeIndex}}" bindchange="onStoreChange"><view class="filter-picker">门店：{{storeName || '请选择'}}</view></picker>
  <view class="toolbar herb-toolbar"><view class="herb-search"><t-input borderless suffix="搜索" value="{{keyword}}" placeholder="药材名称/拼音首字母/编码/位置" bind:change="onKeywordChange" bind:click="search" bind:enter="search" /></view></view>
  <picker mode="selector" range="{{types}}" range-key="label" value="{{typeIndex}}" bindchange="onTypeChange"><view class="filter-picker">位置类型：{{types[typeIndex].label}}</view></picker>
  <view class="app-card location-card" wx:for="{{filteredLocations}}" wx:key="id" data-id="{{item.id}}" bind:tap="selectLocation">
    <view class="status-row">
      <view class="location-code"><text wx:for="{{item.displayCodeSegments}}" wx:for-item="segment" wx:key="index" class="{{segment.highlighted ? 'search-highlight' : ''}}">{{segment.text}}</text></view>
      <t-tag theme="primary" variant="outline"><text wx:for="{{item.positionLabelSegments}}" wx:for-item="segment" wx:key="index" class="{{segment.highlighted ? 'search-highlight' : ''}}">{{segment.text}}</text></t-tag>
    </view>
    <view class="muted">{{item.typeLabel}}</view>
    <view class="herb-summary"><text wx:for="{{item.herbSummarySegments}}" wx:for-item="segment" wx:key="index" class="{{segment.highlighted ? 'search-highlight' : ''}}">{{segment.text}}</text></view>
  </view>
  <t-loading wx:if="{{loading}}" text="加载中" /><t-empty wx:elif="{{!filteredLocations.length}}" description="暂无位置" />

  <view wx:if="{{detailVisible}}" class="overlay" catch:tap="closeDetail"><view class="modal-card" catch:tap="noop"><view class="modal-title"><text wx:for="{{selectedLocation.displayCodeSegments}}" wx:for-item="segment" wx:key="index" class="{{segment.highlighted ? 'search-highlight' : ''}}">{{segment.text}}</text> <text class="close" bind:tap="closeDetail">×</text></view><view class="muted">{{selectedLocation.typeLabel}}</view><view class="detail-actions"><t-button theme="primary" size="small" bind:tap="openAssignment">添加药材</t-button></view><view wx:for="{{selectedLocation.herbs}}" wx:for-index="herbIndex" wx:key="assignmentId" class="herb-row"><view class="herb-main"><view class="herb-name"><text wx:for="{{item.nameSegments}}" wx:for-item="segment" wx:key="index" class="{{segment.highlighted ? 'search-highlight' : ''}}">{{segment.text}}</text></view><view class="muted herb-description"><text wx:for="{{item.descriptionSegments}}" wx:for-item="segment" wx:key="index" class="{{segment.highlighted ? 'search-highlight' : ''}}">{{segment.text}}</text></view></view><view class="row-actions"><view class="row-action-cell"><t-button size="extra-small" theme="primary" data-index="{{herbIndex}}" bind:tap="openPositionEdit">位置</t-button></view><view class="row-action-cell"><t-button size="extra-small" data-index="{{herbIndex}}" bind:tap="openHerbEdit">编辑</t-button></view><view class="row-action-cell"><t-button size="extra-small" theme="danger" data-index="{{herbIndex}}" bind:tap="removeAssignment">删除</t-button></view></view></view><t-empty wx:if="{{!selectedLocation.herbs.length}}" description="未配置药材" /></view></view>

  <view wx:if="{{assignmentVisible}}" class="overlay" catch:tap="closeAssignment"><view class="modal-card" catch:tap="noop"><view class="modal-title">配置药材</view><picker mode="selector" range="{{positionTypes}}" range-key="label" value="{{assignmentTypeIndex}}" bindchange="onAssignmentTypeChange"><view class="filter-picker">位置类型：{{positionTypes[assignmentTypeIndex].label}}</view></picker><t-input wx:if="{{assignmentForm.type === 'D'}}" label="斗" type="number" value="{{assignmentForm.unitNo}}" data-field="unitNo" bind:change="onAssignmentChange" /><t-input wx:else label="{{assignmentForm.type === 'G' ? '柜' : assignmentForm.type === 'F' ? '冰箱' : '仓库'}}" type="number" value="{{assignmentForm.unitNo}}" data-field="unitNo" bind:change="onAssignmentChange" /><t-input label="层" type="number" value="{{assignmentForm.layerNo}}" data-field="layerNo" bind:change="onAssignmentChange" /><t-input wx:if="{{assignmentForm.type === 'D'}}" label="列" type="number" value="{{assignmentForm.columnNo}}" data-field="columnNo" bind:change="onAssignmentChange" /><t-input wx:if="{{assignmentForm.type === 'D'}}" label="格内序号" type="number" value="{{assignmentForm.slotNo}}" placeholder="可选" data-field="slotNo" bind:change="onAssignmentChange" /><picker mode="selector" range="{{herbs}}" range-key="label" bindchange="onHerbChange"><view class="filter-picker">选择已有药材（可选）</view></picker><t-input label="药材名称" value="{{assignmentForm.name}}" placeholder="请输入药材名称" data-field="name" bind:change="onAssignmentChange" /><t-input label="药材编码" value="{{assignmentForm.code}}" placeholder="可选" data-field="code" bind:change="onAssignmentChange" /><t-input label="规格" value="{{assignmentForm.specification}}" placeholder="可选" data-field="specification" bind:change="onAssignmentChange" /><view class="modal-actions"><t-button variant="outline" bind:tap="closeAssignment">取消</t-button><t-button theme="primary" loading="{{saving}}" bind:tap="saveAssignment">保存</t-button></view></view></view>
  <view wx:if="{{positionEditVisible}}" class="overlay" catch:tap="noop"><view class="modal-card" catch:tap="noop"><view class="modal-title">编辑位置</view><view class="muted">{{positionEditForm.name}}</view><picker mode="selector" range="{{positionTypes}}" range-key="label" value="{{positionTypeIndex}}" bindchange="onPositionTypeChange"><view class="filter-picker">位置类型：{{positionTypes[positionTypeIndex].label}}</view></picker><t-input wx:if="{{positionEditForm.type === 'D'}}" label="斗" type="number" value="{{positionEditForm.unitNo}}" data-field="unitNo" bind:change="onPositionChange" /><t-input wx:else label="{{positionEditForm.type === 'G' ? '柜' : positionEditForm.type === 'F' ? '冰箱' : '仓库'}}" type="number" value="{{positionEditForm.unitNo}}" data-field="unitNo" bind:change="onPositionChange" /><t-input label="层" type="number" value="{{positionEditForm.layerNo}}" data-field="layerNo" bind:change="onPositionChange" /><t-input wx:if="{{positionEditForm.type === 'D'}}" label="列" type="number" value="{{positionEditForm.columnNo}}" data-field="columnNo" bind:change="onPositionChange" /><t-input wx:if="{{positionEditForm.type === 'D'}}" label="格内序号" type="number" value="{{positionEditForm.slotNo}}" placeholder="可选" data-field="slotNo" bind:change="onPositionChange" /><view class="modal-actions"><t-button variant="outline" bind:tap="closePositionEdit">取消</t-button><t-button theme="primary" loading="{{saving}}" bind:tap="savePosition">保存</t-button></view></view></view>
  <view wx:if="{{herbEditVisible}}" class="overlay" catch:tap="noop"><view class="modal-card" catch:tap="noop"><view class="modal-title">编辑药材</view><t-input label="药材名称" value="{{herbEditForm.name}}" data-field="name" bind:change="onHerbEditChange" /><t-input label="药材编码" value="{{herbEditForm.code}}" data-field="code" bind:change="onHerbEditChange" /><t-input label="规格" value="{{herbEditForm.specification}}" data-field="specification" bind:change="onHerbEditChange" /><view class="modal-actions"><t-button variant="outline" bind:tap="closeHerbEdit">取消</t-button><t-button theme="primary" loading="{{saving}}" bind:tap="saveHerbEdit">保存</t-button></view></view></view>

  <t-tab-bar value="{{activeTab}}" fixed bind:change="onTabChange"><t-tab-bar-item value="overview" icon="home">概览</t-tab-bar-item><t-tab-bar-item value="herbs" icon="view-module">斗谱</t-tab-bar-item><t-tab-bar-item value="processing" icon="time">加工</t-tab-bar-item><t-tab-bar-item value="packages" icon="view-list">包裹</t-tab-bar-item><t-tab-bar-item value="profile" icon="user">我的</t-tab-bar-item></t-tab-bar>
</view>

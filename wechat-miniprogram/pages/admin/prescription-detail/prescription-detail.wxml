<view class="page" wx:if="{{detail}}">
  <view class="app-card detail-head">
    <view class="status-row">
      <view>
        <view class="code">{{detail.prescriptionNo}}</view>
        <view class="muted">{{detail.customerName}} {{detail.phone || '-'}}</view>
      </view>
      <t-tag theme="{{detail.statusTheme}}">{{detail.statusText}}</t-tag>
    </view>
    <view class="head-actions" wx:if="{{detail.canEdit}}">
      <t-button size="small" theme="primary" variant="outline" bind:tap="editPrescription">编辑处方</t-button>
    </view>
  </view>

  <t-cell-group>
    <t-cell title="所属门店" note="{{detail.storeName}}" />
    <t-cell title="医生" note="{{detail.doctorName}}" />
    <t-cell title="处方来源" note="{{detail.sourceName}}" />
    <t-cell title="处方类型" note="{{detail.isExternal ? '外方' : '本方'}}" />
    <t-cell title="剂数进度" note="{{detail.takenDose}} / {{detail.totalDose}}，剩余 {{detail.remainingDose}} 剂" />
    <t-cell title="录入时间" note="{{detail.createdAtText}}" />
    <t-cell title="录入人" note="{{detail.creatorName}}" />
    <t-cell title="备注" note="{{detail.remark || '-'}}" />
  </t-cell-group>

  <view class="section-title attachment-title">
    <text>处方原件</text>
    <t-button
      wx:if="{{!isStoreStaff}}"
      size="small"
      theme="primary"
      variant="outline"
      loading="{{attachmentPreparing || attachmentUploading}}"
      bind:tap="selectAndUploadAttachment"
    >{{detail.attachment ? '重新上传' : '上传处方'}}</t-button>
  </view>
  <view class="app-card attachment-card" wx:if="{{detail.attachment}}">
    <view class="attachment-info">
      <view class="attachment-name">{{detail.attachment.originalName}}</view>
      <view class="muted">{{detail.attachment.fileSizeText}}</view>
    </view>
    <view class="attachment-actions">
      <t-button size="small" variant="outline" loading="{{attachmentPreviewing}}" bind:tap="previewAttachment">预览</t-button>
      <t-button wx:if="{{!isStoreStaff}}" size="small" theme="danger" variant="outline" loading="{{attachmentDeleting}}" bind:tap="removeAttachment">删除</t-button>
    </view>
  </view>
  <view class="app-card empty-attachment" wx:else>暂无处方原件</view>

  <view class="section-title">
    <text>加工批次</text>
    <view class="section-actions">
      <t-button wx:if="{{detail.canAddPlan}}" size="small" theme="primary" bind:tap="createPlan">新增批次</t-button>
      <t-button size="small" variant="outline" bind:tap="goProcessing">工作台</t-button>
    </view>
  </view>

  <view class="app-card plan-card" wx:for="{{plans}}" wx:key="id" data-id="{{item.id}}" bind:tap="goWorkflow">
    <view class="status-row">
      <view class="plan-title">第 {{item.batchNo}} 批 · {{item.processTypeName}}</view>
      <t-tag theme="{{item.statusTheme}}">{{item.statusText}}</t-tag>
    </view>
    <view class="plan-meta">
      <view>剂数：{{item.totalDose}} 剂</view>
      <view wx:if="{{item.isDecoction}}">袋数：{{item.bagCount}} 袋</view>
      <view wx:if="{{item.isDecoction}}">毫升数：{{item.volumeMl}} ml</view>
      <view>安排：{{item.scheduleText}}</view>
      <view wx:if="{{item.finishDate}}">完成：{{item.finishDateText}}</view>
      <view wx:if="{{item.processRemark || item.remark}}">备注：{{item.processRemark || item.remark}}</view>
    </view>
    <view wx:if="{{item.package || item.canEdit || item.canDelete}}" class="plan-actions">
      <t-button custom-class="batch-action-button" custom-style="width:auto;min-width:0;padding-left:16rpx;padding-right:16rpx;" style="width:auto;display:inline-flex;" wx:if="{{item.package}}" size="small" theme="primary" variant="outline" data-id="{{item.package.id}}" catch:tap="goPackage">取货码 {{item.package.pickupCode}}</t-button>
      <t-button custom-class="batch-action-button" custom-style="width:auto;min-width:0;padding-left:16rpx;padding-right:16rpx;" style="width:auto;display:inline-flex;" wx:if="{{item.canEdit}}" size="small" theme="primary" variant="outline" data-id="{{item.id}}" catch:tap="editPlan">编辑</t-button>
      <t-button custom-class="batch-action-button" custom-style="width:auto;min-width:0;padding-left:16rpx;padding-right:16rpx;" style="width:auto;display:inline-flex;" wx:if="{{item.canDelete}}" size="small" theme="danger" variant="outline" data-id="{{item.id}}" catch:tap="removePlan">删除</t-button>
    </view>
  </view>

  <t-empty wx:if="{{!plans.length}}" description="暂无加工批次" />
</view>

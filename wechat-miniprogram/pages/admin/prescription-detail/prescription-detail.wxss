.detail-head {
  border-top: 6rpx solid #0052d9;
}

.head-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 32rpx 0 20rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.section-actions {
  display: flex;
  gap: 12rpx;
}

.attachment-title {
  margin-bottom: 16rpx;
}

.attachment-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx;
}

.attachment-info {
  min-width: 0;
}

.attachment-actions {
  display: flex;
  flex: 0 0 auto;
  gap: 12rpx;
}

.attachment-name {
  overflow: hidden;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty-attachment {
  padding: 30rpx 24rpx;
  color: #86909c;
  text-align: center;
}

.plan-card {
  padding: 24rpx;
}

.plan-title {
  font-weight: 700;
}

.plan-meta {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 16rpx;
  color: #4e5969;
  font-size: 26rpx;
}

.plan-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: nowrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.plan-actions > t-button {
  flex: 0 0 auto;
  width: auto !important;
}

.batch-action-button {
  width: auto !important;
  min-width: 0 !important;
}

.e6-import-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.e6-summary-grid {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 26rpx;
  color: #1d2129;
}

.e6-summary-item {
  display: flex;
  align-items: center;
}

.e6-price {
  font-weight: 600;
  color: #e34d59;
}

.e6-summary-status {
  margin-left: auto;
}

.e6-table {
  width: 100%;
  margin-top: 16rpx;
  border: 1rpx solid #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
}

.e6-table-header {
  display: flex;
  background-color: #f7f8fa;
  padding: 12rpx 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #86909c;
  align-items: center;
}

.e6-table-row {
  display: flex;
  padding: 14rpx 8rpx;
  font-size: 24rpx;
  color: #1d2129;
  border-top: 1rpx solid #f0f0f0;
  align-items: center;
}

.th-seq, .td-seq {
  width: 64rpx;
  text-align: center;
  flex-shrink: 0;
}

.th-name, .td-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-right: 8rpx;
}

.th-dose, .td-dose {
  width: 72rpx;
  text-align: center;
  flex-shrink: 0;
}

.th-qty, .td-qty {
  width: 110rpx;
  text-align: right;
  flex-shrink: 0;
}

.th-total, .td-total {
  width: 110rpx;
  text-align: right;
  flex-shrink: 0;
}

.td-total.strong {
  font-weight: 600;
}

.e6-empty-items {
  padding: 30rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #86909c;
}

.e6-remark {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #86909c;
}

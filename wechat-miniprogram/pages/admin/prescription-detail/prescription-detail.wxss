.detail-head {
  border-top: 6rpx solid #0052d9;
}

.head-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 32rpx 0 20rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.section-actions {
  display: flex;
  gap: 12rpx;
}

.plan-card {
  padding: 24rpx;
}

.plan-title {
  font-weight: 700;
}

.plan-meta {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 16rpx;
  color: #4e5969;
  font-size: 26rpx;
}

.plan-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: nowrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.plan-actions > t-button {
  flex: 0 0 auto;
  width: auto !important;
}

.batch-action-button {
  width: auto !important;
  min-width: 0 !important;
}

<view class="page">
  <view class="quick-actions">
    <view class="quick-action-item">
      <t-button size="small" theme="primary" bind:tap="goCreate">新增包裹</t-button>
    </view>
    <view class="quick-action-item">
      <t-button size="small" variant="outline" bind:tap="goVerify">扫码/取货码核销</t-button>
    </view>
  </view>

  <view class="toolbar package-toolbar">
    <view class="package-search">
      <t-input borderless suffix="搜索" value="{{keyword}}" placeholder="取货码/手机号/姓名/物品" bind:change="onKeywordChange" bind:click="search" bind:enter="search" />
    </view>
  </view>

  <view class="filters">
    <store-picker value="{{storeId}}" bind:change="onStoreChange" />
    <view class="status-filter">
      <t-button size="small" theme="{{status === '' ? 'primary' : 'default'}}" bind:tap="setAll">全部</t-button>
      <t-button size="small" theme="{{status === 0 ? 'primary' : 'default'}}" bind:tap="setPending">待取</t-button>
      <t-button size="small" theme="{{status === 1 ? 'primary' : 'default'}}" bind:tap="setPicked">已取</t-button>
    </view>
    <view class="sort-filter">
      <t-button size="small" variant="outline" bind:tap="toggleSort">按{{sortByText}}排序</t-button>
    </view>
  </view>

  <view class="app-card app-card-clickable" wx:for="{{list}}" wx:key="id" bind:tap="goDetail" data-id="{{item.id}}">
    <view class="status-row">
      <view>
        <view class="item-title text-h1 text-primary">{{item.itemName}}</view>
        <view class="text-body font-medium" style="margin-top: 12rpx;">{{item.receiverName}} <text class="text-caption">{{item.receiverPhoneMasked}}</text></view>
        <view class="text-caption" style="margin-top: 8rpx;">取货码：<text class="text-body font-medium">{{item.pickupCode}}</text></view>
        <view class="text-caption" wx:if="{{item.storeName}}">门店：{{item.storeName}}</view>
      </view>
      <view class="package-tags" style="display: flex; flex-direction: column; gap: 8rpx; align-items: flex-end;">
        <t-tag theme="primary" variant="light-outline">{{item.pickupMethodText}}</t-tag>
        <t-tag theme="{{item.statusTheme}}" variant="light-outline">{{item.statusText}}</t-tag>
      </view>
    </view>
    <block wx:if="{{item.isPending}}">
      <view class="card-divider-internal"></view>
      <view class="item-actions">
        <t-button theme="primary" size="small" variant="light" data-id="{{item.id}}" catch:tap="goEdit">编辑包裹</t-button>
      </view>
    </block>
  </view>

  <t-loading wx:if="{{loading}}" text="加载中" />
  <t-empty wx:elif="{{!list.length}}" description="暂无包裹" />

  <view class="list-footer" wx:if="{{list.length}}">
    <view wx:if="{{loadingMore}}" class="loading-more">
      <t-loading theme="dots" size="36rpx" text="加载中..." />
    </view>
    <view wx:elif="{{page >= pages}}" class="no-more">
      <text class="muted">已加载全部包裹</text>
    </view>
  </view>

  <t-tab-bar value="{{activeTab}}" fixed bind:change="onTabChange">
    <t-tab-bar-item value="overview" icon="home">库存</t-tab-bar-item>
    <t-tab-bar-item value="herbs" icon="view-module">斗谱</t-tab-bar-item>
    <t-tab-bar-item value="processing" icon="time">加工</t-tab-bar-item>
    <t-tab-bar-item value="packages" icon="view-list">包裹</t-tab-bar-item>
    <t-tab-bar-item value="business" icon="app">业务</t-tab-bar-item>
  </t-tab-bar>
</view>

<view class="page">
  <view class="app-card">
    <picker wx:if="{{isSuperAdmin && !isEdit}}" mode="selector" range="{{stores}}" range-key="name" value="{{storeIndex}}" bindchange="onStoreChange">
      <view class="picker-row">
        <text>所属门店</text>
        <text class="picker-value {{!form.storeId ? 'placeholder' : ''}}">{{form.storeId ? form.storeName : '请选择所属门店'}}</text>
      </view>
    </picker>
    <t-input label="物品名称" value="{{form.itemName}}" placeholder="请输入物品名称" data-field="itemName" bind:change="onChange" />
    <t-input label="收件人" value="{{form.receiverName}}" placeholder="请输入姓名" data-field="receiverName" bind:change="onChange" />
    <t-input label="手机号" value="{{form.receiverPhone}}" type="number" maxlength="11" placeholder="选填，留空不创建用户" data-field="receiverPhone" bind:change="onReceiverPhoneChange" />
    <view wx:if="{{matchingUsers}}" class="matching-hint">正在匹配用户...</view>
    <view wx:if="{{matchedUsers.length}}" class="user-match-list">
      <view class="match-title">已有用户</view>
      <view
        wx:for="{{matchedUsers}}"
        wx:key="id"
        class="user-match-item {{matchedUser && matchedUser.id === item.id ? 'selected' : ''}}"
        data-index="{{index}}"
        bind:tap="selectMatchedUser"
      >
        <view>
          <view class="match-phone">{{item.phone}}</view>
          <view class="match-name">{{item.name || item.nickname || '未填写姓名'}}</view>
        </view>
        <text class="match-remark">{{item.remark || '未填写备注'}}</text>
      </view>
    </view>
    <view wx:if="{{matchedUser}}" class="matched-user">
      <view class="matched-user-row"><text>用户姓名</text><text>{{matchedUser.name || matchedUser.nickname || '-'}}</text></view>
      <view class="matched-user-row"><text>用户备注</text><text>{{matchedUser.remark || '-'}}</text></view>
    </view>
    <view wx:if="{{isNewUser}}" class="new-user-fields">
      <view class="new-user-title">新用户信息</view>
      <t-input label="新用户姓名" value="{{form.newUserName}}" maxlength="64" placeholder="请输入用户姓名" data-field="newUserName" bind:change="onChange" />
      <t-textarea t-class-textarea="compact-textarea" label="新用户备注" value="{{form.newUserRemark}}" maxlength="500" placeholder="请输入用户备注" data-field="newUserRemark" bind:change="onChange" />
    </view>
    <picker mode="selector" range="{{pickupMethodOptions}}" range-key="label" value="{{pickupMethodIndex}}" bindchange="onPickupMethodChange">
      <view class="picker-row">
        <text>取货方式</text>
        <text class="picker-value {{form.pickupMethod === null ? 'placeholder' : ''}}">{{form.pickupMethod === null ? '请选择取货方式' : form.pickupMethodText}}</text>
      </view>
    </picker>
    <t-textarea t-class-textarea="compact-textarea" wx:if="{{form.pickupMethod === 1 || form.pickupMethod === 2}}" label="地址" value="{{form.expressAddress}}" maxlength="500" placeholder="选填" data-field="expressAddress" bind:change="onChange" />
    <view wx:if="{{form.pickupMethod === 2}}" class="tracking-row">
      <t-input label="快递单号" value="{{form.expressTrackingNo}}" maxlength="100" placeholder="输入或扫描顺丰单号" data-field="expressTrackingNo" bind:change="onChange" bind:click="scanTrackingNo">
        <t-icon slot="suffix-icon" name="scan" size="40rpx" color="#0052d9" />
      </t-input>
    </view>
    <t-textarea t-class-textarea="compact-textarea" label="备注" value="{{form.itemInfo}}" placeholder="请输入备注信息" data-field="itemInfo" bind:change="onChange" />
    <view class="submit">
      <t-button theme="primary" block loading="{{loading}}" bind:tap="submit">保存</t-button>
    </view>
  </view>

  <t-tab-bar value="{{activeTab}}" fixed bind:change="onTabChange">
    <t-tab-bar-item value="overview" icon="home">概览</t-tab-bar-item>
    <t-tab-bar-item value="herbs" icon="view-module">斗谱</t-tab-bar-item>
    <t-tab-bar-item value="processing" icon="time">加工</t-tab-bar-item>
    <t-tab-bar-item value="packages" icon="view-list">包裹</t-tab-bar-item>
    <t-tab-bar-item value="profile" icon="user">我的</t-tab-bar-item>
  </t-tab-bar>
</view>

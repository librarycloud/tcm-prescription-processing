<view class="page">
  <view class="app-card">
    <t-input label="物品名称" value="{{form.itemName}}" placeholder="请输入物品名称" data-field="itemName" bind:change="onChange" />
    <t-input label="收件人" value="{{form.receiverName}}" placeholder="请输入姓名" data-field="receiverName" bind:change="onChange" />
    <t-input label="手机号" value="{{form.receiverPhone}}" type="number" maxlength="11" placeholder="选填，留空不关联用户" data-field="receiverPhone" bind:change="onChange" />
    <picker mode="selector" range="{{pickupMethodOptions}}" range-key="label" value="{{pickupMethodIndex}}" bindchange="onPickupMethodChange">
      <view class="picker-row">
        <text>取货方式</text>
        <text class="picker-value {{form.pickupMethod === null ? 'placeholder' : ''}}">{{form.pickupMethod === null ? '请选择取货方式' : form.pickupMethodText}}</text>
      </view>
    </picker>
    <t-textarea t-class-textarea="compact-textarea" wx:if="{{form.pickupMethod === 1 || form.pickupMethod === 2}}" label="地址" value="{{form.expressAddress}}" maxlength="500" placeholder="选填" data-field="expressAddress" bind:change="onChange" />
    <view wx:if="{{form.pickupMethod === 2}}" class="tracking-row">
      <t-input label="快递单号" value="{{form.expressTrackingNo}}" maxlength="100" placeholder="输入或扫描顺丰单号" data-field="expressTrackingNo" bind:change="onChange" bind:click="scanTrackingNo">
        <t-icon slot="suffix-icon" name="scan" size="40rpx" color="#0052d9" />
      </t-input>
    </view>
    <t-textarea t-class-textarea="compact-textarea" label="备注" value="{{form.itemInfo}}" placeholder="请输入备注信息" data-field="itemInfo" bind:change="onChange" />
    <view class="submit">
      <t-button theme="primary" block loading="{{loading}}" bind:tap="submit">保存修改</t-button>
    </view>
  </view>
</view>

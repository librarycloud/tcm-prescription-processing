.page {
  padding-bottom: 220rpx;
}

.page-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.workbench-toolbar {
  display: block;
}

.workbench-search {
  overflow: hidden;
  border: 1rpx solid #dcdcdc;
  border-radius: 6px;
  background: #ffffff;
  --td-input-bg-color: transparent;
  --td-input-vertical-padding: 16rpx 24rpx;
  --td-input-suffix-text-color: #0052d9;
}

.mode-switch {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-bottom: 20rpx;
  padding: 6rpx;
  border: 1rpx solid #e5e6eb;
  border-radius: 8rpx;
  background: #ffffff;
}

.mode-item {
  padding: 18rpx 12rpx;
  border-radius: 6rpx;
  text-align: center;
}

.mode-item.active {
  color: #ffffff;
  background: #0052d9;
  font-weight: 600;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.stat-item {
  min-width: 0;
  padding: 20rpx 10rpx;
  border: 1rpx solid #e5e6eb;
  border-radius: 8rpx;
  background: #ffffff;
  text-align: center;
}

.stat-item.active {
  border-color: #0052d9;
  background: #f2f7ff;
  box-shadow: 0 0 0 2rpx rgba(0, 82, 217, 0.08);
}

.stat-item.active .muted {
  color: #0052d9;
  font-weight: 700;
}

.stat-value {
  color: #0052d9;
  font-size: 36rpx;
  font-weight: 700;
}

.store-filter {
  display: block;
  margin: -4rpx 0 20rpx;
}

.task-card,
.pickup-card {
  padding: 24rpx;
}

.task-card {
  border-left: 6rpx solid #0052d9;
}

.pickup-card {
  border-left: 6rpx solid #00a870;
}

.task-main {
  min-width: 0;
}

.task-title {
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag-group {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 8rpx;
}

.task-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 18rpx;
  color: #4e5969;
  font-size: 26rpx;
}

.pickup-code {
  color: #0052d9;
  font-size: 30rpx;
  font-weight: 700;
}

.action-scroll {
  width: 100%;
  margin-top: 20rpx;
  white-space: nowrap;
}

.task-actions {
  display: inline-flex;
  align-items: center;
  justify-content: flex-start;
  gap: 8rpx;
  padding-bottom: 4rpx;
  box-sizing: border-box;
}

.task-actions.few {
  display: flex;
  justify-content: space-between;
  width: 100%;
  min-width: 100%;
  gap: 20rpx;
}

.task-actions.few.one {
  justify-content: center;
}

.task-actions > t-button {
  flex: 0 0 auto;
  width: auto !important;
}

.action-button {
  width: auto !important;
  min-width: 0 !important;
}

.pager {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

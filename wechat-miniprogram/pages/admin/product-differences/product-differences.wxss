.difference-page { padding-bottom: 220rpx; overflow-x: hidden; }
.page-heading, .status-row, .card-actions, .modal-actions, .item-header { display: flex; align-items: center; }
.page-heading { justify-content: space-between; gap: 16rpx; margin-bottom: 20rpx; }
.page-heading > view { min-width: 0; }
.page-title { font-size: 36rpx; font-weight: 700; }
.view-switch { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-bottom: 20rpx; }
.view-switch > t-button { min-width: 0; }
.difference-switch-button { width: 100% !important; min-width: 0 !important; max-width: 100% !important; padding-right: 8rpx !important; padding-left: 8rpx !important; box-sizing: border-box; font-size: 25rpx !important; }
.summary-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; margin-bottom: 20rpx; }
.summary-item { min-width: 0; padding: 20rpx 8rpx; border: 1rpx solid #e5e6eb; border-radius: 8rpx; background: #fff; text-align: center; }
.summary-item.active { border-color: #0052d9; background: #f2f7ff; }
.summary-value { color: #0052d9; font-size: 40rpx; font-weight: 700; }
.diff-more { color: #00a870; }
.diff-less { color: #d54941; }
.filters { display: flex; flex-direction: column; gap: 14rpx; margin-bottom: 20rpx; }
.filter-picker, .picker-row { min-height: 76rpx; padding: 18rpx 20rpx; box-sizing: border-box; border: 1rpx solid #e5e6eb; border-radius: 8rpx; background: #fff; color: #4e5969; }
.picker-row { display: flex; align-items: center; justify-content: space-between; }
.picker-value { color: #1f2329; }
.search-box { overflow: hidden; border: 1rpx solid #dcdcdc; border-radius: 6px; background: #fff; --td-input-bg-color: transparent; --td-input-vertical-padding: 16rpx 24rpx; --td-input-suffix-text-color: #0052d9; }
.difference-card, .log-card { margin-bottom: 16rpx; }
.card-main { min-width: 0; flex: 1; }
.product-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 29rpx; font-weight: 600; }
.difference-line { margin-top: 16rpx; line-height: 1.5; }
.card-actions { justify-content: flex-end; gap: 12rpx; margin-top: 18rpx; }
.card-actions > t-button { width: auto; min-width: 0; }
.log-product { margin: 14rpx 0 8rpx; font-weight: 600; }
.pager { display: flex; align-items: center; justify-content: center; gap: 20rpx; margin: 28rpx 0; }
.pager > t-button { width: auto; min-width: 0; }
.overlay { position: fixed; z-index: 1001; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; background: rgba(0, 0, 0, .42); }
.modal-card { width: 100%; max-height: 88vh; padding: 28rpx; box-sizing: border-box; overflow-y: auto; border-radius: 24rpx 24rpx 0 0; background: #fff; }
.modal-title { margin-bottom: 20rpx; font-size: 34rpx; font-weight: 700; }
.register-item { margin: 18rpx 0; padding: 16rpx; border: 1rpx solid #eef0f5; border-radius: 8rpx; }
.item-header { justify-content: space-between; margin-bottom: 12rpx; font-weight: 600; }
.product-search { margin-bottom: 14rpx; }
.alert-box { margin-bottom: 16rpx; padding: 18rpx; border-radius: 8rpx; background: #fff7e6; color: #ad6800; line-height: 1.5; }
.modal-actions { justify-content: flex-end; gap: 12rpx; margin-top: 20rpx; }

<view class="page difference-page">
  <view class="page-heading">
    <view>
      <view class="page-title">库存差异</view>
      <view class="muted">登记实货与系统库存的临时差异</view>
    </view>
    <t-button size="small" theme="primary" bind:tap="openRegister">登记差异</t-button>
  </view>

  <view class="view-switch">
    <t-button size="small" block t-class="difference-switch-button" theme="{{activeTab === 'current' ? 'primary' : 'default'}}" bind:tap="showCurrent">当前差异</t-button>
    <t-button size="small" block t-class="difference-switch-button" theme="{{activeTab === 'logs' ? 'primary' : 'default'}}" bind:tap="showLogs">差异流水</t-button>
  </view>

  <view wx:if="{{activeTab === 'current'}}">
    <view class="summary-grid">
      <view class="summary-item {{direction === '' ? 'active' : ''}}" data-direction="" bind:tap="setDirection"><view class="summary-value">{{stats.total}}</view><view class="muted">有差异货品</view></view>
      <view class="summary-item {{direction === 'MORE' ? 'active' : ''}}" data-direction="MORE" bind:tap="setDirection"><view class="summary-value diff-more">{{stats.more}}</view><view class="muted">实货多</view></view>
      <view class="summary-item {{direction === 'LESS' ? 'active' : ''}}" data-direction="LESS" bind:tap="setDirection"><view class="summary-value diff-less">{{stats.less}}</view><view class="muted">实货少</view></view>
    </view>
    <view class="filters">
      <picker wx:if="{{isSuperAdmin}}" mode="selector" range="{{stores}}" range-key="name" value="{{storeIndex}}" bindchange="onStoreChange"><view class="filter-picker">{{storeName}}</view></picker>
      <view class="search-box"><t-input borderless suffix="搜索" value="{{keyword}}" placeholder="商品编号、名称或规格" bind:change="onKeywordChange" bind:click="searchCurrent" bind:enter="searchCurrent" /></view>
    </view>

    <view class="app-card difference-card" wx:for="{{list}}" wx:key="id">
      <view class="status-row"><view class="card-main"><view class="product-title">{{item.productCode}} · {{item.name}}</view><view class="muted">{{item.specification || '无规格'}} · {{item.unit}} · 零售价 ¥{{item.retailPriceText}}</view></view><t-tag theme="{{item.diffQuantity > 0 ? 'success' : 'danger'}}">{{item.diffQuantity > 0 ? '实货多' : '实货少'}}</t-tag></view>
      <view wx:if="{{isSuperAdmin}}" class="muted">门店：{{item.store.name}}</view>
      <view class="difference-line">当前差异：<text class="{{item.diffQuantity > 0 ? 'diff-more' : 'diff-less'}}">{{item.signedDiff}} {{item.unit}}</text></view>
      <view class="card-actions"><t-button size="small" theme="primary" data-index="{{index}}" bind:tap="openWriteOff">销账</t-button><t-button size="small" data-index="{{index}}" bind:tap="openProductLogs">流水</t-button></view>
    </view>
    <t-empty wx:if="{{!loading && !list.length}}" description="暂无库存差异" />
    <t-loading wx:if="{{loading}}" text="加载中" />
    <view class="pager"><t-button size="small" theme="light" disabled="{{page <= 1}}" bind:tap="prevPage">上一页</t-button><text class="muted">{{page}} / {{pages}}</text><t-button size="small" disabled="{{page >= pages}}" bind:tap="nextPage">下一页</t-button></view>
  </view>

  <view wx:else>
    <view class="filters">
      <picker wx:if="{{isSuperAdmin}}" mode="selector" range="{{stores}}" range-key="name" value="{{logStoreIndex}}" bindchange="onLogStoreChange"><view class="filter-picker">{{logStoreName}}</view></picker>
      <view class="search-box"><t-input borderless suffix="搜索" value="{{logKeyword}}" placeholder="单号、商品、供货商或经办人" bind:change="onLogKeywordChange" bind:click="searchLogs" bind:enter="searchLogs" /></view>
      <picker mode="selector" range="{{operationOptions}}" range-key="label" value="{{operationIndex}}" bindchange="onOperationChange"><view class="filter-picker">类型：{{operationOptions[operationIndex].label}}</view></picker>
    </view>
    <view class="app-card log-card" wx:for="{{logs}}" wx:key="id">
      <view class="status-row"><view class="product-title">{{item.operationNo}}</view><t-tag theme="{{item.operationTheme}}">{{item.operationText}}</t-tag></view>
      <view class="log-product">{{item.product.productCode}} · {{item.product.name}}</view>
      <view class="muted">业务日期：{{item.businessDateText}}　创建人：{{item.creatorName}}</view>
      <view class="difference-line">数量变化：<text class="{{item.changeQuantity > 0 ? 'diff-more' : 'diff-less'}}">{{item.signedChange}} {{item.product.unit}}</text>　操作后：{{item.signedBalance}} {{item.product.unit}}</view>
      <view wx:if="{{item.remark}}" class="muted">备注：{{item.remark}}</view>
      <view class="card-actions" wx:if="{{item.canReverse}}"><t-button size="small" theme="danger" data-index="{{index}}" bind:tap="openReverse">冲销</t-button></view>
    </view>
    <t-empty wx:if="{{!logsLoading && !logs.length}}" description="暂无差异流水" />
    <t-loading wx:if="{{logsLoading}}" text="加载中" />
    <view class="pager"><t-button size="small" theme="light" disabled="{{logPage <= 1}}" bind:tap="prevLogPage">上一页</t-button><text class="muted">{{logPage}} / {{logPages}}</text><t-button size="small" disabled="{{logPage >= logPages}}" bind:tap="nextLogPage">下一页</t-button></view>
  </view>

  <view wx:if="{{registerVisible}}" class="overlay" catch:tap="closeRegister"><view class="modal-card" catch:tap="noop">
    <view class="modal-title">登记库存差异</view>
    <picker wx:if="{{isSuperAdmin}}" mode="selector" range="{{stores}}" range-key="name" value="{{registerStoreIndex}}" bindchange="onRegisterStoreChange"><view class="filter-picker">门店：{{registerStoreName}}</view></picker>
    <picker mode="selector" range="{{registerTypes}}" range-key="label" value="{{registerTypeIndex}}" bindchange="onRegisterTypeChange"><view class="filter-picker">差异类型：{{registerTypes[registerTypeIndex].label}}</view></picker>
    <picker mode="date" value="{{registerForm.businessDate}}" bindchange="onRegisterDateChange"><view class="picker-row"><text>业务日期</text><text class="picker-value">{{registerForm.businessDate}}</text></view></picker>
    <view class="search-box product-search"><t-input borderless suffix="搜索" value="{{productKeyword}}" placeholder="搜索商品编号、名称或规格" bind:change="onProductKeywordChange" bind:click="searchProducts" bind:enter="searchProducts" /></view>
    <view wx:for="{{registerForm.items}}" wx:key="key" class="register-item">
      <view class="item-header"><text>商品 {{index + 1}}</text><t-button wx:if="{{registerForm.items.length > 1}}" size="extra-small" theme="danger" variant="text" data-index="{{index}}" bind:tap="removeRegisterItem">删除</t-button></view>
      <picker mode="selector" range="{{productOptions}}" range-key="label" value="{{item.productIndex}}" data-index="{{index}}" bindchange="onProductChange"><view class="filter-picker">{{item.productLabel || '请选择商品'}}</view></picker>
      <t-input label="数量" type="number" value="{{item.quantity}}" data-index="{{index}}" bind:change="onRegisterQuantityChange" />
      <t-input label="批号/备注" value="{{item.batchNote}}" data-index="{{index}}" bind:change="onRegisterBatchChange" />
    </view>
    <t-button size="small" variant="outline" bind:tap="addRegisterItem">添加商品</t-button>
    <t-input label="供货商" value="{{registerForm.supplierName}}" data-field="supplierName" bind:change="onRegisterFieldChange" />
    <t-input label="经办人" value="{{registerForm.borrowerName}}" data-field="borrowerName" bind:change="onRegisterFieldChange" />
    <t-textarea t-class-textarea="compact-textarea" label="备注" value="{{registerForm.remark}}" data-field="remark" bind:change="onRegisterFieldChange" />
    <view class="modal-actions"><t-button bind:tap="closeRegister">取消</t-button><t-button theme="primary" loading="{{saving}}" bind:tap="saveRegister">确认登记</t-button></view>
  </view></view>

  <view wx:if="{{writeOffVisible}}" class="overlay" catch:tap="closeWriteOff"><view class="modal-card" catch:tap="noop">
    <view class="modal-title">库存差异销账</view><view class="alert-box">{{writeOffTitle}}：{{selectedProduct.name}}，当前差异 {{selectedProduct.signedDiff}} {{selectedProduct.unit}}</view>
    <picker mode="date" value="{{writeOffForm.businessDate}}" bindchange="onWriteOffDateChange"><view class="picker-row"><text>销账日期</text><text class="picker-value">{{writeOffForm.businessDate}}</text></view></picker>
    <t-input label="销账数量" type="number" value="{{writeOffForm.quantity}}" data-field="quantity" bind:change="onWriteOffFieldChange" />
    <t-input label="系统单据号" value="{{writeOffForm.systemDocumentNo}}" data-field="systemDocumentNo" bind:change="onWriteOffFieldChange" />
    <t-input label="经办人" value="{{writeOffForm.borrowerName}}" data-field="borrowerName" bind:change="onWriteOffFieldChange" />
    <t-textarea t-class-textarea="compact-textarea" label="备注" value="{{writeOffForm.remark}}" data-field="remark" bind:change="onWriteOffFieldChange" />
    <view class="modal-actions"><t-button bind:tap="closeWriteOff">取消</t-button><t-button theme="primary" loading="{{saving}}" bind:tap="saveWriteOff">确认销账</t-button></view>
  </view></view>

  <view wx:if="{{reverseVisible}}" class="overlay" catch:tap="closeReverse"><view class="modal-card" catch:tap="noop"><view class="modal-title">冲销差异流水</view><view class="alert-box">确认冲销 {{selectedLog.operationNo}}？</view><t-textarea t-class-textarea="compact-textarea" label="冲销原因" value="{{reverseReason}}" bind:change="onReverseReasonChange" /><view class="modal-actions"><t-button bind:tap="closeReverse">取消</t-button><t-button theme="danger" loading="{{saving}}" bind:tap="saveReverse">确认冲销</t-button></view></view></view>

  <t-tab-bar value="{{activeTabBar}}" fixed bind:change="onTabChange"><t-tab-bar-item value="overview" icon="home">库存</t-tab-bar-item><t-tab-bar-item value="herbs" icon="view-module">斗谱</t-tab-bar-item><t-tab-bar-item value="processing" icon="time">加工</t-tab-bar-item><t-tab-bar-item value="packages" icon="view-list">包裹</t-tab-bar-item><t-tab-bar-item value="business" icon="app">业务</t-tab-bar-item><t-tab-bar-item value="profile" icon="user">我的</t-tab-bar-item></t-tab-bar>
</view>

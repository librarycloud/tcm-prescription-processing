<view class="page yd-check-page">
  <view wx:if="{{!selectedCheck}}">
    <view class="page-heading"><view><view class="page-title">药店商品盘点</view><view class="muted">选择盘点单后，按商品和库存批号完成盘点</view></view><t-button size="small" theme="primary" bind:tap="openCreate">新建盘点</t-button></view>
    <view wx:for="{{checks}}" wx:key="id" class="app-card check-card" data-index="{{index}}" bind:tap="selectCheck">
      <view class="check-title">{{item.checkName}}</view>
      <view class="muted">{{item.store.name || '-'}}　{{item.summary.counted || 0}} / {{item.summary.total || 0}} 条已盘</view>
    </view>
    <t-loading wx:if="{{checksLoading}}" text="加载中" />
    <t-empty wx:if="{{!checksLoading && !checks.length}}" description="暂无进行中的盘点单" />
  </view>

  <view wx:else>
    <view class="page-heading"><view><view class="page-title">{{selectedCheck.checkName}}</view><view class="muted">{{selectedCheck.store.name || '-'}}</view></view><t-button size="small" variant="outline" bind:tap="backToChecks">切换盘点单</t-button></view>
    <view class="search-panel"><view class="search-row"><t-icon class="search-scan-icon" name="scan" size="44rpx" color="#0052d9" bind:tap="scan" /><t-input class="search-input" borderless suffix="查询商品" value="{{keyword}}" placeholder="名称、编码或条码" bind:change="onKeywordChange" bind:click="search" bind:enter="search" /></view></view>

    <view wx:if="{{candidateProducts.length}}" class="product-results"><view class="section-title">匹配商品</view><view wx:for="{{candidateProducts}}" wx:key="id" class="app-card product-option" data-index="{{index}}" bind:tap="selectProduct"><view class="product-title">{{item.productCode}} · {{item.name}}</view><view class="muted">单位：{{item.unit || '-'}}　规格：{{item.specification || '-'}}</view><view class="muted">生产厂商：{{item.manufacturer || '-'}}　条码：{{item.barcode || '无条码'}}　{{item.inventoryCount}} 个库存批次</view></view></view>
    <t-empty wx:if="{{candidateSearched && !candidateLoading && !candidateProducts.length}}" description="暂无匹配商品" />

    <view wx:if="{{selectedProduct}}"><view class="section-title inventory-heading"><text>库存信息</text><t-button size="small" variant="text" theme="primary" bind:tap="openManualCount">新增批号</t-button></view><view class="selected-product">{{selectedProduct.productCode}} · {{selectedProduct.name}}</view>
      <view wx:for="{{selectedInventories}}" wx:key="id" class="app-card inventory-card"><view class="inventory-row"><text>批号</text><text>{{item.batchNo || '-'}}</text></view><view class="inventory-row"><text>系统货位</text><text>{{item.locationName || '-'}}</text></view><view class="inventory-row"><text>盘点货位</text><text>{{item.countLocationName || '-'}}</text></view><view class="inventory-row strong"><text>系统数量</text><text>{{item.quantity}} {{selectedProduct.unit || ''}}</text></view><view class="inventory-metrics"><view class="inventory-metric"><text>初盘</text><text>{{item.firstCountText}} {{item.firstCountText == '-' ? '' : selectedProduct.unit}}</text></view><view class="inventory-metric"><text>复盘</text><text>{{item.recountText}} {{item.recountText == '-' ? '' : selectedProduct.unit}}</text></view><view class="inventory-metric"><text>差异</text><text class="{{item.differenceText == '-' || item.differenceText == '0' ? '' : 'difference-value'}}">{{item.differenceText}}</text></view></view><view class="inventory-row"><text>生产日期</text><text>{{item.productionDateText}}</text></view><view class="inventory-row"><text>有效期</text><text>{{item.expiryDateText}}</text></view><view class="inventory-row"><text>金额</text><text>¥ {{item.amountText}}</text></view><view class="inventory-action"><text class="{{item.checkStatus == 2 ? '' : 'muted'}}">{{item.checkStatus == 2 ? '待复盘' : (item.counted ? (item.recountQty !== null && item.recountQty !== undefined ? '已复盘' : '待复核') : '待盘点')}}</text><t-button wx:if="{{item.checkStatus == 2 && item.checkItemId}}" size="small" theme="primary" data-index="{{index}}" bind:tap="openCount">复盘</t-button><t-button wx:elif="{{!item.counted}}" size="small" theme="primary" data-index="{{index}}" bind:tap="openCount">盘点</t-button></view></view>
      <t-empty wx:if="{{!selectedInventories.length}}" description="该商品暂无库存批次" />
    </view>
  </view>

  <view wx:if="{{createVisible}}" class="overlay" catch:tap="closeCreate"><view class="modal-card" catch:tap="noop"><view class="modal-title">新建盘点</view><picker wx:if="{{isSuperAdmin}}" mode="selector" range="{{stores}}" range-key="name" value="{{createStoreIndex}}" bindchange="onCreateStoreChange"><view class="store-picker">门店：{{createStoreName}}</view></picker><t-input label="盘点名称" value="{{checkName}}" placeholder="如：月度库存盘点" bind:change="onCheckNameChange" /><view class="modal-actions"><t-button bind:tap="closeCreate">取消</t-button><t-button theme="primary" loading="{{creating}}" bind:tap="createCheck">创建</t-button></view></view></view>

  <view wx:if="{{countVisible}}" class="overlay" catch:tap="closeCount"><view class="modal-card" catch:tap="noop"><view class="modal-title">{{countForm.mode === 'recount' ? '复盘' : '初盘'}}记录</view><view class="confirm-row"><text>商品</text><text>{{countForm.product.productCode}} · {{countForm.product.name}}</text></view><t-input wx:if="{{countForm.manualBatch}}" label="批号" value="{{countForm.batchNo}}" placeholder="输入新增批号" data-field="batchNo" bind:change="onCountFieldChange" /><view wx:else class="confirm-row"><text>批号</text><text>{{countForm.batchNo || '-'}}</text></view><view class="confirm-row"><text>{{countForm.mode === 'recount' ? '复盘系统数量' : '系统数量'}}</text><text>{{countForm.systemQty}}</text></view><t-input label="盘点货位" value="{{countForm.locationName}}" readonly="{{!countForm.locationEditing}}" placeholder="默认使用系统货位" data-field="locationName" bind:change="onCountFieldChange"><t-icon slot="suffix-icon" name="edit-1" size="40rpx" color="#0052d9" bind:tap="editLocation" /></t-input><t-input label="{{countForm.mode === 'recount' ? '复盘数量' : '初盘数量'}}" type="number" value="{{countForm.countQty}}" placeholder="输入实际盘点数量" data-field="countQty" bind:change="onCountFieldChange" /><view class="modal-actions"><t-button bind:tap="closeCount">取消</t-button><t-button theme="primary" loading="{{saving}}" bind:tap="saveCount">确认保存</t-button></view></view></view>

  <t-tab-bar value="{{activeTab}}" fixed bind:change="onTabChange"><t-tab-bar-item value="overview" icon="home">概览</t-tab-bar-item><t-tab-bar-item value="herbs" icon="view-module">斗谱</t-tab-bar-item><t-tab-bar-item value="processing" icon="time">加工</t-tab-bar-item><t-tab-bar-item value="packages" icon="view-list">包裹</t-tab-bar-item><t-tab-bar-item value="profile" icon="user">我的</t-tab-bar-item></t-tab-bar>
</view>

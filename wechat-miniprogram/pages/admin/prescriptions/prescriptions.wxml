<view class="page">
  <view class="page-actions">
    <t-button theme="primary" bind:tap="goCreate">新建处方</t-button>
  </view>

  <view class="toolbar prescription-toolbar">
    <view class="prescription-search">
      <t-input borderless suffix="搜索" value="{{keyword}}" placeholder="处方编号/姓名/手机号/医生" bind:change="onKeywordChange" bind:click="search" bind:enter="search" />
    </view>
  </view>

  <view class="filter-scroll">
    <view class="filter-row {{isSuperAdmin ? 'filter-row-five' : 'filter-row-four'}}">
      <t-button block size="small" t-class="filter-button" theme="{{status === '' ? 'primary' : 'default'}}" data-status="" bind:tap="setStatus">全部</t-button>
      <t-button block size="small" t-class="filter-button" theme="{{status === 0 ? 'primary' : 'default'}}" data-status="0" bind:tap="setStatus">进行中</t-button>
      <t-button block size="small" t-class="filter-button" theme="{{status === 1 ? 'primary' : 'default'}}" data-status="1" bind:tap="setStatus">已完成</t-button>
      <t-button block size="small" t-class="filter-button" theme="{{status === 2 ? 'primary' : 'default'}}" data-status="2" bind:tap="setStatus">已取消</t-button>
      <picker wx:if="{{isSuperAdmin}}" mode="selector" range="{{stores}}" range-key="name" value="{{storeIndex}}" bindchange="onStoreChange">
        <t-button block size="small" t-class="filter-button" variant="outline">{{storeName}}</t-button>
      </picker>
    </view>
  </view>

  <view class="app-card prescription-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bind:tap="goDetail">
    <view class="status-row">
      <view class="card-main">
        <view class="prescription-no">{{item.prescriptionNo}}</view>
        <view class="customer-name">{{item.customerName}} <text class="muted">{{item.phoneMasked}}</text></view>
      </view>
      <t-tag theme="{{item.statusTheme}}">{{item.statusText}}</t-tag>
    </view>
    <view class="meta-grid">
      <view><text class="muted">医生：</text>{{item.doctorName}}</view>
      <view><text class="muted">来源：</text>{{item.sourceName}}</view>
      <view><text class="muted">剂数：</text>{{item.takenDose}} / {{item.totalDose}}</view>
      <view><text class="muted">批次：</text>{{item.plansCount}}</view>
    </view>
    <view class="muted" wx:if="{{item.storeName}}">门店：{{item.storeName}}</view>
    <view class="muted">录入：{{item.createdAtText}}</view>
    <view class="card-actions">
      <t-button size="small" variant="outline" data-id="{{item.id}}" catch:tap="goDetail">详情</t-button>
      <t-button wx:if="{{item.canEdit}}" size="small" theme="primary" variant="outline" data-id="{{item.id}}" catch:tap="goEdit">编辑</t-button>
      <t-button wx:if="{{item.canDelete}}" size="small" theme="danger" variant="outline" data-id="{{item.id}}" data-no="{{item.prescriptionNo}}" catch:tap="remove">删除</t-button>
    </view>
  </view>

  <t-loading wx:if="{{loading}}" text="加载中" />
  <t-empty wx:elif="{{!list.length}}" description="暂无处方" />

  <view class="pager">
    <t-button theme="light" size="small" disabled="{{page <= 1}}" bind:tap="prevPage">上一页</t-button>
    <view class="pager-current"><text>{{page}}</text><text class="muted"> / {{pages}} 页</text></view>
    <t-button size="small" disabled="{{page >= pages}}" bind:tap="nextPage">下一页</t-button>
  </view>

  <t-tab-bar value="{{activeTab}}" fixed bind:change="onTabChange">
    <t-tab-bar-item value="overview" icon="home">概览</t-tab-bar-item>
    <t-tab-bar-item value="herbs" icon="view-module">斗谱</t-tab-bar-item>
    <t-tab-bar-item value="processing" icon="time">加工</t-tab-bar-item>
    <t-tab-bar-item value="packages" icon="view-list">包裹</t-tab-bar-item>
    <t-tab-bar-item value="profile" icon="user">我的</t-tab-bar-item>
  </t-tab-bar>
</view>

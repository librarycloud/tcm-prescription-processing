<view class="page">
  <view class="page-actions" wx:if="{{!isStoreStaff}}">
    <t-button theme="primary" bind:tap="goCreate">新建处方</t-button>
  </view>

  <view class="toolbar prescription-toolbar">
    <view class="prescription-search">
      <t-input borderless suffix="搜索" value="{{keyword}}" placeholder="处方编号/姓名/手机号/医生" bind:change="onKeywordChange" bind:click="search" bind:enter="search" />
    </view>
  </view>

  <view class="filter-scroll">
    <view class="filter-row {{isSuperAdmin ? 'filter-row-five' : 'filter-row-four'}}">
      <t-button block size="small" t-class="filter-button" theme="{{status === '' ? 'primary' : 'default'}}" data-status="" bind:tap="setStatus">全部</t-button>
      <t-button block size="small" t-class="filter-button" theme="{{status === 0 ? 'primary' : 'default'}}" data-status="0" bind:tap="setStatus">进行中</t-button>
      <t-button block size="small" t-class="filter-button" theme="{{status === 1 ? 'primary' : 'default'}}" data-status="1" bind:tap="setStatus">已完成</t-button>
      <t-button block size="small" t-class="filter-button" theme="{{status === 2 ? 'primary' : 'default'}}" data-status="2" bind:tap="setStatus">已取消</t-button>
      <picker wx:if="{{isSuperAdmin}}" mode="selector" range="{{stores}}" range-key="name" value="{{storeIndex}}" bindchange="onStoreChange">
        <t-button block size="small" t-class="filter-button" variant="outline">{{storeName}}</t-button>
      </picker>
    </view>
  </view>

  <view class="app-card app-card-clickable prescription-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bind:tap="goDetail">
    <view class="status-row">
      <view class="card-main">
        <view class="prescription-no text-h2 text-primary">{{item.prescriptionNo}}</view>
        <view class="customer-name text-h2 font-medium" style="margin-top: 12rpx;">{{item.customerName}} <text class="text-caption">{{item.phoneMasked}}</text></view>
      </view>
      <t-tag theme="{{item.statusTheme}}" variant="light-outline">{{item.statusText}}</t-tag>
    </view>
    <view class="meta-grid">
      <view><text class="text-caption">医生：</text><text class="text-body font-medium">{{item.doctorName}}</text></view>
      <view><text class="text-caption">来源：</text><text class="text-body font-medium">{{item.sourceName}}</text></view>
      <view><text class="text-caption">剂数：</text><text class="text-body font-medium">{{item.takenDose}} / {{item.totalDose}}</text></view>
      <view><text class="text-caption">批次：</text><text class="text-body font-medium">{{item.plansCount}}</text></view>
    </view>
    <view class="text-caption" wx:if="{{item.storeName}}" style="margin-top: 8rpx;">门店：{{item.storeName}}</view>
    <view class="text-caption" style="margin-top: 4rpx;">录入：{{item.createdAtText}}</view>
    
    <view class="card-divider-internal"></view>
    
    <view class="card-actions">
      <t-button size="small" variant="outline" data-id="{{item.id}}" catch:tap="goDetail">详情</t-button>
      <t-button wx:if="{{item.canEdit}}" size="small" theme="primary" variant="light" data-id="{{item.id}}" catch:tap="goEdit">编辑</t-button>
      <t-button wx:if="{{item.canDelete}}" size="small" theme="danger" variant="text" data-id="{{item.id}}" data-no="{{item.prescriptionNo}}" catch:tap="remove">删除</t-button>
    </view>
  </view>

  <t-loading wx:if="{{loading}}" text="加载中" />
  <t-empty wx:elif="{{!list.length}}" description="暂无处方" />

  <view class="list-footer" wx:if="{{list.length}}">
    <view wx:if="{{loadingMore}}" class="loading-more">
      <t-loading theme="dots" size="36rpx" text="加载中..." />
    </view>
    <view wx:elif="{{page >= pages}}" class="no-more">
      <text class="muted">已加载全部处方</text>
    </view>
  </view>
</view>

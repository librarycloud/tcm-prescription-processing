<view class="page business-page">
  <view class="page-heading">
    <view class="page-title">业务管理</view>
    <view class="muted">常用业务功能</view>
  </view>

  <view class="business-grid">
    <view class="app-card business-item" data-url="/pages/admin/prescriptions/prescriptions" hover-class="business-item-active" bind:tap="openPage">
      <t-icon name="file" size="48rpx" color="#0052d9" />
      <view class="business-item-title">处方管理</view>
      <view class="muted">查看和维护处方</view>
    </view>
    <view wx:if="{{userRole !== 3}}" class="app-card business-item" data-url="/pages/admin/store-transfers/store-transfers" hover-class="business-item-active" bind:tap="openPage">
      <t-icon name="swap" size="48rpx" color="#0052d9" />
      <view class="business-item-title">门店调拨</view>
      <view class="muted">管理门店间调拨</view>
    </view>
    <view wx:if="{{userRole !== 3}}" class="app-card business-item" data-url="/pages/admin/product-differences/product-differences" hover-class="business-item-active" bind:tap="openPage">
      <t-icon name="error-circle" size="48rpx" color="#0052d9" />
      <view class="business-item-title">库存差异</view>
      <view class="muted">处理库存差异记录</view>
    </view>
    <view class="app-card business-item" data-url="/pages/admin/yd-goods-checks/yd-goods-checks" hover-class="business-item-active" bind:tap="openPage">
      <t-icon name="fact-check" size="48rpx" color="#0052d9" />
      <view class="business-item-title">商品盘点</view>
      <view class="muted">盘点药店商品库存</view>
    </view>
    <view class="app-card business-item" data-url="/pages/admin/herb-locations/herb-locations" hover-class="business-item-active" bind:tap="openPage">
      <t-icon name="view-module" size="48rpx" color="#0052d9" />
      <view class="business-item-title">斗谱配置</view>
      <view class="muted">配置药材和货位</view>
    </view>
    <view class="app-card business-item" data-url="/pages/admin/e6-inventory/e6-inventory" hover-class="business-item-active" bind:tap="openPage">
      <t-icon name="search" size="48rpx" color="#0052d9" />
      <view class="business-item-title">库存查询</view>
      <view class="muted">查询药店库存批次</view>
    </view>
  </view>

  <t-tab-bar value="{{activeTab}}" fixed bind:change="onTabChange">
    <t-tab-bar-item value="overview" icon="home">库存</t-tab-bar-item>
    <t-tab-bar-item value="herbs" icon="view-module">斗谱</t-tab-bar-item>
    <t-tab-bar-item value="processing" icon="time">加工</t-tab-bar-item>
    <t-tab-bar-item value="packages" icon="view-list">包裹</t-tab-bar-item>
    <t-tab-bar-item value="business" icon="app">业务</t-tab-bar-item>
    <t-tab-bar-item value="profile" icon="user">我的</t-tab-bar-item>
  </t-tab-bar>
</view>

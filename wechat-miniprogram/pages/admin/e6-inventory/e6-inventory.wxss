.inventory-page { padding-bottom: 180rpx; }
.page-heading { margin-bottom: 20rpx; }
.page-title { font-size: 36rpx; font-weight: 700; }
.search-panel { position: relative; margin-bottom: 18rpx; }
.search-row { display: flex; align-items: center; gap: 12rpx; overflow: hidden; border: 1rpx solid #dcdcdc; border-radius: 6px; background: #ffffff; --td-input-bg-color: transparent; --td-input-vertical-padding: 16rpx 24rpx; --td-input-suffix-text-color: #0052d9; }
.search-scan-icon { flex: 0 0 auto; padding: 8rpx; }
.search-input { min-width: 0; flex: 1; }
.section-title { margin: 28rpx 0 14rpx; color: #4e5969; font-size: 28rpx; font-weight: 600; }
.product-option { margin-bottom: 14rpx; }
.product-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 30rpx; font-weight: 600; }
.product-option .muted, .product-detail .muted { margin-top: 10rpx; line-height: 1.5; }
.inventory-total { margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid #eef0f5; color: #4e5969; }
.inventory-total text { color: #0052d9; font-size: 34rpx; font-weight: 700; }
.inventory-card { margin-bottom: 14rpx; }
.inventory-row { display: flex; justify-content: space-between; gap: 24rpx; margin-bottom: 12rpx; color: #4e5969; }
.inventory-row text:last-child { min-width: 0; color: #1f2329; text-align: right; word-break: break-all; }
.inventory-row.strong { font-size: 30rpx; font-weight: 600; }
.inventory-dates { padding-top: 14rpx; border-top: 1rpx solid #eef0f5; line-height: 1.6; }

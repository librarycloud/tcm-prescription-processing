<view class="page operation-page">
  <t-loading wx:if="{{loading && !detail}}" text="加载中" />

  <block wx:if="{{detail}}">
    <view class="app-card plan-summary">
      <view class="summary-head">
        <view>
          <view class="customer">{{detail.prescription.customerName}}</view>
          <view class="muted">{{detail.planCode}} · 第 {{detail.batchNo}} 批</view>
        </view>
        <t-tag theme="primary">{{stageName}}</t-tag>
      </view>
      <view class="summary-grid">
        <view>{{detail.processType.name}}</view>
        <view>{{detail.totalDose}} 剂</view>
        <view wx:if="{{detail.isDecoction}}">{{detail.bagCount}} 袋 / {{detail.volumeMl}} ml</view>
      </view>
    </view>

    <view wx:if="{{detail.status === 0}}" class="primary-action">
      <t-button theme="primary" block bind:tap="startPlan">开始调配</t-button>
    </view>

    <view wx:if="{{showProcessingSteps}}" class="app-card step-card">
      <view class="step-head">
        <view class="step-index">1</view>
        <view><view class="step-title">调配</view><view class="muted">完成后上传现场照片</view></view>
      </view>
      <view wx:if="{{detail.dispensingCompletedAt}}" class="step-result">
        已完成：{{detail.dispensingCompletedAtText}}
      </view>
      <view class="photo-list" wx:if="{{detail.photos.length}}">
        <view class="photo-item" wx:for="{{detail.photos}}" wx:key="id">
          <t-button
            size="small"
            variant="outline"
            data-id="{{item.id}}"
            bind:tap="viewPhoto"
          >查看照片 {{index + 1}}</t-button>
          <t-button
            wx:if="{{canDeletePhotos}}"
            size="small"
            theme="danger"
            variant="outline"
            data-id="{{item.id}}"
            bind:tap="deletePhoto"
          >删除</t-button>
        </view>
      </view>
      <t-button wx:if="{{canUploadPhoto}}" theme="primary" block bind:tap="takeDispensingPhoto">
        {{detail.photos.length ? '补充调配照片' : '拍照并完成调配'}}
      </t-button>
      <view wx:if="{{canCancel}}" class="cancel-action">
        <t-button theme="danger" variant="outline" block bind:tap="cancelPlan">取消加工</t-button>
      </view>
    </view>

    <view wx:if="{{showProcessingSteps && detail.isDecoction}}" class="app-card step-card">
      <view class="step-head">
        <view class="step-index">2</view>
        <view><view class="step-title">浸泡</view><view class="muted">可连续扫描多个浸泡桶</view></view>
      </view>
      <view class="usage-row" wx:for="{{activeSoakings}}" wx:key="id">
        <view>
          <view class="usage-title">第 {{item.portionNo}} 组 · {{item.equipment.name}}</view>
          <view class="muted">{{item.startedAtText}} · {{item.durationText}}</view>
          <view class="muted">操作人：{{item.operatorName}}</view>
        </view>
        <view class="usage-actions">
          <t-button size="small" theme="primary" data-portion="{{item.portionNo}}" bind:tap="startDecoction">
            扫锅转煎煮
          </t-button>
          <t-button size="small" variant="outline" data-usage="{{item.id}}" bind:tap="handleUsageException">
            异常处理
          </t-button>
        </view>
      </view>
      <view wx:if="{{processingFinished}}" class="step-result">浸泡已完成</view>
      <t-button wx:if="{{canStartSoaking}}" variant="outline" block bind:tap="startSoaking">
        扫码添加浸泡桶
      </t-button>
    </view>

    <view wx:if="{{showProcessingSteps && detail.isDecoction}}" class="app-card step-card">
      <view class="step-head">
        <view class="step-index">3</view>
        <view><view class="step-title">煎煮</view><view class="muted">完成后直接扫描包装机，无需再次扫描煎药机</view></view>
      </view>
      <view class="usage-row" wx:for="{{activeDecoctions}}" wx:key="id">
        <view>
          <view class="usage-title">第 {{item.portionNo}} 组 · {{item.equipment.name}}</view>
          <view class="muted">{{item.startedAtText}} · {{item.durationText}}</view>
          <view class="muted">操作人：{{item.operatorName}}</view>
        </view>
        <view class="usage-actions">
          <t-button size="small" theme="success" data-usage="{{item.id}}" bind:tap="finishWithPackaging">
            扫包装机
          </t-button>
          <t-button size="small" variant="outline" data-usage="{{item.id}}" bind:tap="handleUsageException">
            异常处理
          </t-button>
        </view>
      </view>
      <view wx:if="{{processingFinished}}" class="step-result">煎煮已完成</view>
      <view wx:elif="{{!activeDecoctions.length}}" class="empty-step">暂无进行中的煎煮</view>
    </view>

    <view wx:if="{{showProcessingSteps && detail.isDecoction}}" class="app-card step-card">
      <view class="step-head">
        <view class="step-index">4</view>
        <view><view class="step-title">打包</view><view class="muted">每组药扫描包装机后即完成该组加工</view></view>
      </view>
      <view wx:if="{{packagingCompleted}}" class="step-result">
        全部分组已完成打包
      </view>
      <view wx:else class="empty-step">等待煎煮完成后扫描包装机</view>
    </view>

    <view wx:if="{{usageHistory.length}}" class="app-card history-card">
      <view class="step-title">设备工序记录</view>
      <view class="history-item" wx:for="{{usageHistory}}" wx:key="id">
        <view class="history-main">
          <view>{{item.stageName}} · 第 {{item.portionNo}} 组 · {{item.equipment.name}}</view>
          <view class="usage-flags">{{item.statusName}} · {{item.sourceName}}</view>
          <view class="muted">{{item.startedAtText}} → {{item.endedAtText}}</view>
          <view class="muted">操作人：{{item.operatorName}}</view>
          <view wx:if="{{item.voidReason}}" class="exception-text">撤销原因：{{item.voidReason}}</view>
        </view>
        <view class="duration">{{item.durationText}}</view>
      </view>
    </view>

    <view wx:if="{{detail.workflowExceptions.length}}" class="app-card history-card">
      <view class="step-title">异常处理记录</view>
      <view class="exception-item" wx:for="{{detail.workflowExceptions}}" wx:key="id">
        <view>{{item.typeName}} · {{item.reason}}</view>
        <view class="muted">{{item.createdAtText}} · {{item.operatorName}}</view>
      </view>
    </view>

    <view wx:if="{{detail.status === 1 && !canFinish && detail.completionBlockers.length}}" class="app-card blocker-card">
      <view class="step-title">暂不能完成加工</view>
      <view class="blocker-item" wx:for="{{detail.completionBlockers}}" wx:key="*this">{{item}}</view>
    </view>

    <view wx:if="{{canFinish}}" class="finish-bar">
      <t-button theme="success" block bind:tap="finishPlan">加工完成</t-button>
    </view>
  </block>
</view>

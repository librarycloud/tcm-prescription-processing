.operation-page {
  padding-bottom: 180rpx;
}

.plan-summary,
.step-card,
.history-card {
  padding: 24rpx;
}

.summary-head,
.step-head,
.usage-row,
.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.customer {
  font-size: 38rpx;
  font-weight: 700;
}

.summary-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 28rpx;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #e5e6eb;
  font-weight: 600;
}

.primary-action {
  margin: 24rpx 0;
}

.step-card,
.history-card {
  margin-top: 20rpx;
}

.step-head {
  justify-content: flex-start;
  margin-bottom: 22rpx;
}

.step-index {
  display: grid;
  place-items: center;
  flex: 0 0 52rpx;
  width: 52rpx;
  height: 52rpx;
  color: #fff;
  background: #0052d9;
  border-radius: 50%;
  font-weight: 700;
}

.step-title,
.usage-title {
  font-size: 30rpx;
  font-weight: 700;
}

.step-result {
  margin-bottom: 18rpx;
  padding: 16rpx;
  color: #006c45;
  background: #e8f8f2;
  border-radius: 6rpx;
}

.photo-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.cancel-action {
  margin-top: 12rpx;
}

.photo-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.usage-row,
.history-item {
  padding: 18rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.usage-row.next-step-row {
  display: block;
}

.next-step-action {
  margin-top: 16rpx;
}

.usage-row > view,
.history-main {
  min-width: 0;
}

.usage-actions {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  margin-left: auto;
}

.usage-flags {
  margin-top: 6rpx;
  color: #0052d9;
  font-size: 24rpx;
}

.exception-text,
.blocker-item {
  margin-top: 8rpx;
  color: #c64700;
  font-size: 24rpx;
}

.exception-item {
  padding: 18rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.blocker-card {
  margin-top: 20rpx;
  padding: 24rpx;
  border-left: 6rpx solid #e37318;
}

.empty-step {
  padding: 20rpx 0;
  color: #86909c;
  text-align: center;
}

.duration {
  flex-shrink: 0;
  font-weight: 600;
}

.finish-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #e5e6eb;
}

.transfer-page { padding-bottom: 220rpx; }
.page-actions { display: flex; justify-content: flex-end; margin-bottom: 20rpx; }
.stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; margin-bottom: 20rpx; }
.stat-item { padding: 20rpx 8rpx; border: 1rpx solid #e5e6eb; border-radius: 8rpx; background: #fff; text-align: center; }
.stat-value { color: #0052d9; font-size: 36rpx; font-weight: 700; }
.toolbar { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx; }
.transfer-toolbar { display: block; }
.transfer-search { overflow: hidden; border: 1rpx solid #dcdcdc; border-radius: 6px; background: #fff; --td-input-bg-color: transparent; --td-input-vertical-padding: 16rpx 24rpx; --td-input-suffix-text-color: #0052d9; }
.grow { flex: 1; min-width: 0; }
.filters { display: flex; gap: 12rpx; margin-bottom: 20rpx; }
.filter-picker, .picker-row { min-height: 76rpx; padding: 18rpx 20rpx; box-sizing: border-box; border: 1rpx solid #e5e6eb; border-radius: 8rpx; background: #fff; }
.filter-picker { color: #4e5969; }
.transfer-card { margin-bottom: 16rpx; }
.transfer-title { color: #0052d9; font-size: 30rpx; font-weight: 700; }
.transfer-meta { margin: 14rpx 0 8rpx; color: #1f2329; }
.tag-line { display: flex; gap: 10rpx; margin-top: 12rpx; }
.pager { display: flex; justify-content: center; align-items: center; gap: 24rpx; margin: 28rpx 0; }
.overlay { position: fixed; z-index: 1001; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; background: rgba(0, 0, 0, .42); }
.modal-card { width: 100%; max-height: 88vh; padding: 28rpx; box-sizing: border-box; overflow-y: auto; border-radius: 24rpx 24rpx 0 0; background: #fff; }
.detail-modal { max-height: 82vh; }
.modal-title { margin-bottom: 20rpx; color: #1f2329; font-size: 34rpx; font-weight: 700; }
.close { float: right; color: #86909c; font-size: 44rpx; font-weight: 400; }
.picker-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.picker-value { color: #1f2329; }
.item-header, .modal-actions { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin: 16rpx 0; }
.item-editor { margin: 12rpx 0; padding: 16rpx; border-radius: 8rpx; background: #f7f8fa; }
.detail-lines { display: grid; gap: 10rpx; margin: 18rpx 0; color: #4e5969; font-size: 26rpx; }
.sub-title { margin: 18rpx 0 10rpx; color: #1f2329; font-weight: 700; }
.detail-item { position: relative; margin-bottom: 10rpx; padding: 16rpx; border-radius: 8rpx; background: #f7f8fa; }
.detail-item t-button { margin-top: 10rpx; }
.return-row { margin: 12rpx 0; padding: 16rpx; border-radius: 8rpx; background: #f7f8fa; }
.action-wrap { flex-wrap: wrap; justify-content: center; }

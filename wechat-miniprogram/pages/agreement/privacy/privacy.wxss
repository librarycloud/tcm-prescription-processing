.agreement-page {
  color: #1f2329;
  line-height: 1.7;
}

.title {
  margin-bottom: 20rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.updated {
  margin-bottom: 24rpx;
  color: #4e5969;
  font-weight: 600;
}

.section-title {
  margin: 36rpx 0 16rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.sub-title {
  margin: 24rpx 0 8rpx;
  font-weight: 600;
}

.paragraph {
  margin-bottom: 16rpx;
}

.list-item {
  position: relative;
  margin-bottom: 10rpx;
  padding-left: 28rpx;
  color: #4e5969;
}

.list-item::before {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 20rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #86909c;
}

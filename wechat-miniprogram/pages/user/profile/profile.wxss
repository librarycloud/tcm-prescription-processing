.profile-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  color: #fff;
  background: linear-gradient(135deg, #0052d9 0%, #366ef4 100%);
  font-size: 42rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(0, 82, 217, 0.25);
  flex-shrink: 0;
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.profile-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 6rpx;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2329;
}

.profile-sub {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
}

.profile-info {
  padding-top: 8rpx;
  padding-bottom: 28rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 80rpx;
  border-bottom: 1rpx solid #eef0f5;
}

.info-row:last-of-type {
  border-bottom: 0;
}

.info-label {
  flex: 0 0 160rpx;
  width: 160rpx;
  color: #86909c;
  font-size: 28rpx;
}

.info-value {
  flex: 1;
  color: #1f2329;
  font-size: 28rpx;
  text-align: right;
  word-break: break-all;
}

.wechat-value {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  min-height: 80rpx;
}

.wechat-value-active {
  opacity: 0.65;
}

.wechat-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.pill-bound {
  background: #e6f8ea;
  color: #00a870;
}

.pill-unbound {
  background: #f2f3f5;
  color: #86909c;
}

.wechat-action-btn {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  color: #0052d9;
  font-size: 26rpx;
}

.wechat-binding-panel {
  margin-top: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #e5e6eb;
  border-radius: 12rpx;
  background: #f7f8fa;
}

.wechat-binding-title {
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.wechat-password-wrap {
  margin-top: 20rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dcdfe6;
  border-radius: 12rpx;
  background: #ffffff;
}

.wechat-binding-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}

.submit {
  margin-top: 32rpx;
}

.edit-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 32rpx;
}

.form-row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  border-bottom: 1rpx solid #eef0f5;
}

.form-label {
  flex: 0 0 160rpx;
  width: 160rpx;
  color: #1f2329;
  font-size: 28rpx;
  font-weight: 500;
  box-sizing: border-box;
}


.form-control,
.form-control-wrap {
  flex: 1;
  min-width: 0;
}

.form-control {
  height: 88rpx;
  color: #1f2329;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-control-wrap {
  display: flex;
  align-items: center;
}

.email-code-wrap {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  gap: 12rpx;
}

.email-code-wrap .form-control {
  flex: 1;
  min-width: 0;
}

.email-code-wrap t-button {
  flex: 0 0 auto;
}

.password-control {
  flex: 1;
  min-width: 0;
}

.password-eye {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 34rpx;
  width: 34rpx;
  height: 34rpx;
  margin-left: 16rpx;
  padding: 0;
  color: #86909c;
  background: transparent;
  line-height: 1;
}

.about {
  margin-top: 32rpx;
}

.logout {
  margin-top: 16rpx;
}

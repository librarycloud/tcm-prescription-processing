.profile-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  color: #fff;
  background: #0052d9;
  font-size: 40rpx;
  font-weight: 700;
}

.profile-main {
  min-width: 0;
}

.profile-name {
  margin-bottom: 8rpx;
  font-size: 34rpx;
  font-weight: 600;
}

.profile-info {
  padding-top: 8rpx;
  padding-bottom: 28rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 76rpx;
  border-bottom: 1rpx solid #eef0f5;
}

.info-row:last-of-type {
  border-bottom: 0;
}

.info-label {
  display: flex;
  align-items: center;
  flex: 0 0 136rpx;
  width: 136rpx;
  color: #86909c;
  font-size: 26rpx;
}

.info-label-text {
  display: flex;
  justify-content: space-between;
  width: 112rpx;
}

.info-label-colon {
  flex: 0 0 auto;
  margin-left: 4rpx;
}

.info-value {
  flex: 1;
  color: #1f2329;
  font-size: 28rpx;
  text-align: right;
  word-break: break-all;
}

.wechat-value {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-height: 76rpx;
  color: #86909c;
}

.wechat-value-active {
  opacity: 0.65;
}

.wechat-status.bound {
  color: #00a870;
}

.wechat-action-text {
  color: #0052d9;
}

.wechat-binding-panel {
  margin-top: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #e5e6eb;
  border-radius: 6px;
  background: #f7f8fa;
}

.wechat-binding-title {
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.wechat-password-wrap {
  margin-top: 20rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dcdfe6;
  border-radius: 6px;
  background: #ffffff;
}

.wechat-binding-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}

.submit {
  margin-top: 32rpx;
}

.edit-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 32rpx;
}

.form-row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  border-bottom: 1rpx solid #eef0f5;
}

.form-label {
  display: flex;
  align-items: center;
  flex: 0 0 168rpx;
  width: 168rpx;
  padding-right: 20rpx;
  color: #1f2329;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-label-text {
  display: flex;
  justify-content: space-between;
  width: 112rpx;
}

.form-label-colon {
  flex: 0 0 auto;
  margin-left: 4rpx;
}

.form-control,
.form-control-wrap {
  flex: 1;
  min-width: 0;
}

.form-control {
  height: 88rpx;
  color: #1f2329;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-control-wrap {
  display: flex;
  align-items: center;
}

.email-code-wrap {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  gap: 12rpx;
}

.email-code-wrap .form-control {
  flex: 1;
  min-width: 0;
}

.email-code-wrap t-button {
  flex: 0 0 auto;
}

.password-control {
  flex: 1;
  min-width: 0;
}

.password-eye {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 34rpx;
  width: 34rpx;
  height: 34rpx;
  margin-left: 16rpx;
  padding: 0;
  color: #86909c;
  background: transparent;
  line-height: 1;
}

.logout {
  margin-top: 32rpx;
}

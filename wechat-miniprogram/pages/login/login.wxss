.login-page {
  display: flex;
  flex-direction: column;
  padding-top: 120rpx;
}

.brand {
  margin-bottom: 40rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1f2329;
}

.subtitle {
  margin-top: 12rpx;
  color: #86909c;
}

.login-action {
  margin-top: 32rpx;
}

.wechat-login-section {
  margin-top: 48rpx;
  margin-bottom: 24rpx;
}

.wechat-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.wechat-divider .line {
  flex: 1;
  height: 1rpx;
  background: #e5e6eb;
}

.wechat-divider .text {
  padding: 0 24rpx;
  font-size: 24rpx;
  color: #86909c;
}

.btn-wechat {
  background: #07c160 !important;
  border-color: #07c160 !important;
  color: #ffffff !important;
  font-size: 30rpx !important;
  font-weight: 500 !important;
  border-radius: 16rpx !important;
  box-shadow: 0 6rpx 20rpx rgba(7, 193, 96, 0.2) !important;
}

.btn-wechat:active {
  background: #06ad56 !important;
  opacity: 0.9 !important;
}

.agreement {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: auto;
  padding: 18rpx 20rpx;
  border-radius: 8rpx;
  background: #ffffff;
  color: #5f6673;
  font-size: 24rpx;
  line-height: 1.5;
}

.agreement-check {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
}

.agreement-text {
  flex: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  min-height: 48rpx;
}

.link {
  color: #0052d9;
  font-weight: 500;
}

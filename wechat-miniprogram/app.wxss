page {
  background: #f5f7fa;
  color: #1f2329;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(144rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.section {
  margin-bottom: 24rpx;
}

.section-title {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 32rpx 0 20rpx;
  padding-left: 18rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
  box-sizing: border-box;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: #0052d9;
  border-radius: 3rpx;
}

.app-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 16rpx;
  border: 1rpx solid #eef0f5;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.app-card-clickable:active {
  opacity: 0.92;
  transform: scale(0.995);
}

.toolbar {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 20rpx;
}

.toolbar .grow {
  flex: 1;
}

.compact-textarea {
  height: 144rpx !important;
  min-height: 144rpx !important;
  max-height: 144rpx !important;
  overflow-y: auto !important;
}

.muted {
  color: #86909c;
  font-size: 24rpx;
}

.code-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.code {
  color: #0052d9;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.selectable {
  user-select: text;
  -webkit-user-select: text;
}

.copy-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 14rpx;
  background: #f2f7ff;
  color: #0052d9;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
  border: 1rpx solid rgba(0, 82, 217, 0.18);
  transition: all 0.2s ease;
}

.copy-badge:active {
  background: #dbeafe;
  transform: scale(0.96);
}

.copy-badge-sm {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 10rpx;
  margin-left: 8rpx;
  background: #f2f7ff;
  color: #0052d9;
  border-radius: 12rpx;
  font-size: 20rpx;
  border: 1rpx solid rgba(0, 82, 217, 0.18);
}

.copy-badge-sm:active {
  background: #dbeafe;
}

.copy-icon-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  opacity: 0.8;
  transition: opacity 0.2s ease;
}

.copy-icon-btn:active {
  opacity: 1;
  background: #f2f7ff;
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}


page {
  background: #f5f7fa;
  color: #1f2329;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 144rpx;
  box-sizing: border-box;
}

.section {
  margin-bottom: 24rpx;
}

.app-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.06);
  box-sizing: border-box;
}

.toolbar {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 20rpx;
}

.toolbar .grow {
  flex: 1;
}

.compact-textarea {
  height: 144rpx !important;
  min-height: 144rpx !important;
  max-height: 144rpx !important;
  overflow-y: auto !important;
}

.muted {
  color: #86909c;
  font-size: 24rpx;
}

.code {
  color: #0052d9;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

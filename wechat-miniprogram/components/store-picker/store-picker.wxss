:host {
  display: inline-block;
}

.filter-picker {
  display: inline-flex;
  align-items: center;
  font-size: 26rpx;
  color: #4b5563;
  background: #f3f4f6;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
}

.picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
}

.picker-value {
  color: #1f2937;
  font-weight: 500;
}

.picker-value.placeholder {
  color: #9ca3af;
  font-weight: normal;
}

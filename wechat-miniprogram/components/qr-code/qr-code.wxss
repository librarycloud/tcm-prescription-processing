.qr-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
}

.qr-canvas {
  background: #ffffff;
}

.qr-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8c8c8c;
}

.qr-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.qr-dialog {
  width: 640rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.qr-dialog-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f1f1f;
  margin-bottom: 24rpx;
}

.qr-big-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 16rpx;
  background: #ffffff;
  border-radius: 12rpx;
}

.qr-big-canvas {
  background: #ffffff;
}

.qr-dialog-desc {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #8c8c8c;
}

.qr-dialog-btn {
  margin-top: 32rpx;
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: #1890ff;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
}

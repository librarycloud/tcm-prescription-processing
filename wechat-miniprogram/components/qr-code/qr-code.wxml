<view class="qr-wrap" bindtap="onTapQr">
  <image
    wx:if="{{qrImageUrl}}"
    class="qr-image"
    src="{{qrImageUrl}}"
    style="width: {{size}}px; height: {{size}}px;"
    mode="aspectFit"
    show-menu-by-longpress="{{false}}"
  ></image>
  <view wx:else class="qr-placeholder" style="width: {{size}}px; height: {{size}}px;"></view>
  <view wx:if="{{enablePreview}}" class="qr-tip">点击放大二维码</view>
</view>

<canvas type="2d" id="qrFallbackCanvas" class="qr-canvas-hidden" style="width: 320px; height: 320px;"></canvas>

<view wx:if="{{previewing}}" class="qr-mask" bindtap="closePreview">
  <view class="qr-dialog" catchtap="noop">
    <view class="qr-dialog-title">出示取货二维码</view>
    <view class="qr-big-wrap">
      <image
        wx:if="{{qrImageUrl}}"
        class="qr-big-image"
        src="{{qrImageUrl}}"
        style="width: {{bigSize}}px; height: {{bigSize}}px;"
        mode="aspectFit"
        show-menu-by-longpress="{{false}}"
      ></image>
    </view>
    <view class="qr-dialog-desc">已自动调亮屏幕，方便扫码核销</view>
    <button class="qr-dialog-btn" bindtap="closePreview">完成</button>
  </view>
</view>


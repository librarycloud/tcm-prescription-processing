generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  username        String    @db.VarChar(64)
  password        String    @db.VarChar(255)
  phone           String    @unique @db.VarChar(20)
  openid          String?   @unique @db.VarChar(64)
  unionid         String?   @unique @db.VarChar(64)
  wechatBoundAt   DateTime? @map("wechat_bound_at")
  role            Int       @default(1) @db.TinyInt
  status          Int       @default(1) @db.TinyInt
  storeId         Int?      @map("store_id")
  nickname        String?   @db.VarChar(64)
  name            String?   @db.VarChar(64)
  email           String?   @unique @db.VarChar(191)
  emailVerifiedAt DateTime? @map("email_verified_at")
  remark          String?   @db.VarChar(500)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdBy       Int?      @map("created_by")
  updatedBy       Int?      @map("updated_by")

  createdPackages                Package[]                     @relation("PackageCreatedBy")
  verifiedPackages               Package[]                     @relation("PackageVerifiedBy")
  modifiedPackages               Package[]                     @relation("PackageModifiedBy")
  store                          Store?                        @relation(fields: [storeId], references: [id])
  emailVerificationCodes         EmailVerificationCode[]
  prescriptionsCreated           Prescription[]                @relation("PrescriptionCreatedBy")
  prescriptionAttachmentsCreated PrescriptionAttachment[]      @relation("PrescriptionAttachmentCreatedBy")
  processingPlansCreated         ProcessingPlan[]              @relation("ProcessingPlanCreatedBy")
  processingPhotosCreated        ProcessingPhoto[]             @relation("ProcessingPhotoCreatedBy")
  processingExceptionsCreated    ProcessingWorkflowException[] @relation("ProcessingWorkflowExceptionCreatedBy")
  printTemplatesCreated          PrintTemplate[]               @relation("PrintTemplateCreatedBy")
  storeTransfersCreated          StoreTransfer[]               @relation("StoreTransferCreatedBy")
  transferReturns                StoreTransferReturn[]         @relation("StoreTransferReturnOperator")
  confirmedTransferReturns       StoreTransferReturn[]         @relation("StoreTransferReturnConfirmedBy")
  confirmedTransferOutbounds     StoreTransfer[]               @relation("StoreTransferOutboundConfirmedBy")
  robotConfigsCreated            RobotConfig[]                 @relation("RobotConfigCreatedBy")
  robotConfigsUpdated            RobotConfig[]                 @relation("RobotConfigUpdatedBy")
  robotEventConfigsCreated       RobotEventConfig[]            @relation("RobotEventConfigCreatedBy")
  robotEventConfigsUpdated       RobotEventConfig[]            @relation("RobotEventConfigUpdatedBy")
  robotNotificationEvents        RobotNotificationEvent[]      @relation("RobotNotificationEventOperator")
  productDiffLogsCreated         ProductsDiffLog[]             @relation("ProductsDiffLogCreatedBy")

  @@index([role])
  @@index([status])
  @@index([storeId])
  @@map("users")
}

model Store {
  id                   Int       @id @default(autoincrement())
  name                 String    @unique @db.VarChar(100)
  code                 String    @unique @db.VarChar(50)
  address              String?   @db.VarChar(255)
  phone                String?   @db.VarChar(20)
  status               Int       @default(1) @db.TinyInt
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  createdBy            Int?      @map("created_by")
  updatedBy            Int?      @map("updated_by")
  deletedAt            DateTime? @map("deleted_at")
  deletedBy            Int?      @map("deleted_by")
  drawerLayerCount     Int       @default(8) @map("drawer_layer_count") @db.TinyInt
  drawerUnitCount      Int       @default(5) @map("drawer_unit_count") @db.TinyInt
  drawerLayerColumns   String    @default("[6,6,6,6,6,6,6,3]") @map("drawer_layer_columns") @db.VarChar(255)
  drawerTopColumnCount Int       @default(6) @map("drawer_top_column_count") @db.TinyInt
  bigCabinetUnitCount  Int       @default(5) @map("big_cabinet_unit_count") @db.TinyInt
  bigCabinetLayerCount Int       @default(3) @map("big_cabinet_layer_count") @db.TinyInt
  e6Enabled            Int       @default(0) @map("e6_enabled") @db.TinyInt
  e6ApiKeyHash         String?   @map("e6_api_key_hash") @db.VarChar(64)
  e6ApiKeyHint         String?   @map("e6_api_key_hint") @db.VarChar(16)
  e6LastUsedAt         DateTime? @map("e6_last_used_at")
  e6RotatedAt          DateTime? @map("e6_rotated_at")

  users               User[]
  packages            Package[]
  prescriptions       Prescription[]
  processingPlans     ProcessingPlan[]
  printTemplates      PrintTemplate[]
  loginLogs           LoginLog[]
  operationLogs       OperationLog[]
  transfersOut        StoreTransfer[]       @relation("StoreTransferFromStore")
  transfersIn         StoreTransfer[]       @relation("StoreTransferToStore")
  herbs               Herb[]
  herbLocations       HerbLocation[]
  robotConfigs        RobotConfig[]
  products            Product[]
  productDiffLogs     ProductsDiffLog[]
  e6DoctorMappings    E6DoctorMapping[]
  e6OperatorMappings  E6OperatorMapping[]
  e6Imports           E6Import[]
  e6PharmacyInventory E6PharmacyInventoryBatch[]
  ydGoodsChecks       YdGoodsCheck[]
  ydGoodsCheckItems   YdGoodsCheckItem[]
  processingEquipment ProcessingEquipment[]

  @@index([status])
  @@index([e6Enabled])
  @@map("stores")
}

model Herb {
  id            Int      @id @default(autoincrement())
  storeId       Int      @map("store_id")
  code          String?  @db.VarChar(64)
  name          String   @db.VarChar(100)
  specification String?  @db.VarChar(100)
  status        Int      @default(1) @db.TinyInt
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdBy     Int?     @map("created_by")
  updatedBy     Int?     @map("updated_by")

  store       Store                    @relation(fields: [storeId], references: [id])
  assignments HerbLocationAssignment[]

  @@index([storeId, name])
  @@index([storeId, code])
  @@map("herbs")
}

model Product {
  id            Int       @id @default(autoincrement())
  storeId       Int       @map("store_id")
  productCode   String    @map("product_code") @db.VarChar(64)
  name          String    @db.VarChar(120)
  specification String?   @db.VarChar(120)
  unit          String    @db.VarChar(20)
  retailPrice   Decimal   @default(0) @map("retail_price") @db.Decimal(14, 2)
  diffQuantity  Decimal   @default(0) @map("diff_quantity") @db.Decimal(12, 3)
  status        Int       @default(1) @db.TinyInt
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  createdBy     Int?      @map("created_by")
  updatedBy     Int?      @map("updated_by")
  deletedAt     DateTime? @map("deleted_at")
  deletedBy     Int?      @map("deleted_by")

  store    Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  diffLogs ProductsDiffLog[]

  @@unique([storeId, productCode])
  @@index([storeId, name])
  @@index([storeId, status])
  @@index([storeId, diffQuantity])
  @@map("products")
}

model E6PharmacyProduct {
  id                  Int       @id @default(autoincrement())
  e6ProductId         Int       @map("e6_product_id")
  productCode         String    @map("product_code") @db.VarChar(64)
  name                String    @db.VarChar(120)
  category            String?   @db.VarChar(100)
  categoryCode        String?   @map("category_code") @db.VarChar(64)
  barcode             String?   @db.VarChar(64)
  specification       String?   @db.VarChar(120)
  dosageForm          String?   @map("dosage_form") @db.VarChar(64)
  manufacturer        String?   @db.VarChar(200)
  categoryAttribute   String?   @map("category_attribute") @db.VarChar(100)
  unit                String?   @db.VarChar(30)
  e6CreatedAt         DateTime? @map("e6_created_at")
  e6ModifiedAt        DateTime? @map("e6_modified_at")
  lastInventorySeenAt DateTime? @map("last_inventory_seen_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  inventories E6PharmacyInventoryBatch[]
  checkItems  YdGoodsCheckItem[]

  @@unique([e6ProductId])
  @@index([productCode])
  @@index([barcode])
  @@index([e6ModifiedAt])
  @@map("e6_pharmacy_products")
}

model E6PharmacyInventoryBatch {
  id             Int       @id @default(autoincrement())
  storeId        Int       @map("store_id")
  productId      Int       @map("product_id")
  batchNo        String    @default("") @map("batch_no") @db.VarChar(100)
  productionDate DateTime? @map("production_date") @db.Date
  expiryDate     DateTime? @map("expiry_date") @db.Date
  inboundDate    DateTime? @map("inbound_date") @db.Date
  locationName   String    @default("") @map("location_name") @db.VarChar(120)
  quantity       Decimal   @db.Decimal(14, 3)
  amount         Decimal   @db.Decimal(14, 2)
  receivedAt     DateTime  @default(now()) @map("received_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  store   Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product E6PharmacyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId, batchNo, locationName])
  @@index([storeId, productId])
  @@index([storeId, expiryDate])
  @@map("e6_pharmacy_inventory_batches")
}

model YdGoodsCheck {
  id        Int       @id @default(autoincrement())
  storeId   Int       @map("store_id")
  checkName String    @map("check_name") @db.VarChar(150)
  checkType Int       @default(1) @map("check_type") @db.TinyInt
  status    Int       @default(0) @db.TinyInt
  createdBy Int       @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  startedAt DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  store Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  items YdGoodsCheckItem[]

  @@index([storeId, status])
  @@index([storeId, createdAt])
  @@map("yd_goods_check")
}

model YdGoodsCheckItem {
  id                 Int       @id @default(autoincrement())
  checkId            Int       @map("check_id")
  storeId            Int       @map("store_id")
  productId          Int       @map("product_id")
  batchNo            String    @default("") @map("batch_no") @db.VarChar(100)
  systemLocationName String    @default("") @map("system_location_name") @db.VarChar(120)
  countLocationName  String?   @map("count_location_name") @db.VarChar(120)
  systemQty          Decimal   @default(0) @map("system_qty") @db.Decimal(14, 3)
  firstCountQty      Decimal?  @map("first_count_qty") @db.Decimal(14, 3)
  firstCountedAt     DateTime? @map("first_counted_at")
  firstCountedBy     Int?      @map("first_counted_by")
  recountQty         Decimal?  @map("recount_qty") @db.Decimal(14, 3)
  recountSystemQty   Decimal?  @map("recount_system_qty") @db.Decimal(14, 3)
  recountedAt        DateTime? @map("recounted_at")
  recountedBy        Int?      @map("recounted_by")
  locationStatus     Int       @default(0) @map("location_status") @db.TinyInt
  checkStatus        Int       @default(0) @map("check_status") @db.TinyInt
  reviewStatus       Int       @default(0) @map("review_status") @db.TinyInt
  reviewedBy         Int?      @map("reviewed_by")
  reviewedAt         DateTime? @map("reviewed_at")
  remark             String?   @db.VarChar(500)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  check   YdGoodsCheck       @relation(fields: [checkId], references: [id], onDelete: Cascade)
  store   Store              @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product E6PharmacyProduct  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([storeId, checkId])
  @@index([storeId, checkStatus])
  @@index([storeId, productId, batchNo])
  @@map("yd_goods_check_item")
}

model ProductsDiffLog {
  id               Int      @id @default(autoincrement())
  operationNo      String   @map("operation_no") @db.VarChar(32)
  storeId          Int      @map("store_id")
  productId        Int      @map("product_id")
  operationType    String   @map("operation_type") @db.VarChar(32)
  changeQuantity   Decimal  @map("change_quantity") @db.Decimal(12, 3)
  balanceAfter     Decimal  @map("balance_after") @db.Decimal(12, 3)
  businessDate     DateTime @map("business_date") @db.Date
  batchNote        String?  @map("batch_note") @db.VarChar(120)
  borrowerName     String?  @map("borrower_name") @db.VarChar(100)
  supplierName     String?  @map("supplier_name") @db.VarChar(120)
  relatedLogId     Int?     @map("related_log_id")
  systemDocumentNo String?  @map("system_document_no") @db.VarChar(100)
  remark           String?  @db.VarChar(500)
  createdBy        Int      @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")

  store      Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product    Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  creator    User              @relation("ProductsDiffLogCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  relatedLog ProductsDiffLog?  @relation("ProductsDiffLogRelated", fields: [relatedLogId], references: [id], onDelete: Restrict)
  childLogs  ProductsDiffLog[] @relation("ProductsDiffLogRelated")

  @@index([storeId, businessDate])
  @@index([productId, createdAt])
  @@index([operationNo])
  @@index([operationType, businessDate])
  @@index([relatedLogId])
  @@map("products_diff_logs")
}

model HerbLocation {
  id               Int      @id @default(autoincrement())
  storeId          Int      @map("store_id")
  locationCode     String   @map("location_code") @db.VarChar(20)
  locationType     String   @map("location_type") @db.Char(1)
  unitNo           Int      @map("unit_no") @db.TinyInt
  layerNo          Int      @map("layer_no") @db.SmallInt
  columnNo         Int?     @map("column_no") @db.TinyInt
  medicineCapacity Int?     @map("medicine_capacity") @db.TinyInt
  status           Int      @default(1) @db.TinyInt
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdBy        Int?     @map("created_by")
  updatedBy        Int?     @map("updated_by")

  store       Store                    @relation(fields: [storeId], references: [id])
  assignments HerbLocationAssignment[]

  @@unique([storeId, locationCode])
  @@index([storeId, locationType, unitNo, layerNo, columnNo], map: "herb_location_scope_idx")
  @@map("herb_locations")
}

model HerbLocationAssignment {
  id         Int      @id @default(autoincrement())
  locationId Int      @map("location_id")
  herbId     Int      @map("herb_id")
  slotNo     Int?     @map("slot_no") @db.TinyInt
  createdAt  DateTime @default(now()) @map("created_at")
  createdBy  Int?     @map("created_by")

  location HerbLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  herb     Herb         @relation(fields: [herbId], references: [id], onDelete: Restrict)

  @@unique([locationId, herbId])
  @@unique([locationId, slotNo])
  @@index([herbId])
  @@map("herb_location_assignments")
}

model Package {
  id                 Int       @id @default(autoincrement())
  storeId            Int       @map("store_id")
  pickupCode         String    @unique @map("pickup_code") @db.VarChar(6)
  itemName           String    @map("item_name") @db.VarChar(120)
  itemInfo           String?   @map("item_info") @db.VarChar(500)
  receiverName       String    @map("receiver_name") @db.VarChar(64)
  receiverPhone      String?   @map("receiver_phone") @db.VarChar(20)
  status             Int       @default(0) @db.TinyInt
  pickupMethod       Int?      @map("pickup_method") @db.TinyInt
  expressTrackingNo  String?   @map("express_tracking_no") @db.VarChar(100)
  expressAddress     String?   @map("express_address") @db.VarChar(500)
  createdAt          DateTime  @default(now()) @map("created_at")
  pickedAt           DateTime? @map("picked_at")
  modifiedAt         DateTime? @map("modified_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  createdBy          Int       @map("created_by")
  verifiedBy         Int?      @map("verified_by")
  modifiedBy         Int?      @map("modified_by")
  updatedBy          Int?      @map("updated_by")
  deletedAt          DateTime? @map("deleted_at")
  deletedBy          Int?      @map("deleted_by")
  notificationStatus Int       @default(0) @map("notification_status") @db.TinyInt
  notificationCount  Int       @default(0) @map("notification_count")
  lastNotificationAt DateTime? @map("last_notification_at")
  processingPlanId   Int?      @unique @map("processing_plan_id")

  creator        User            @relation("PackageCreatedBy", fields: [createdBy], references: [id])
  verifier       User?           @relation("PackageVerifiedBy", fields: [verifiedBy], references: [id])
  modifier       User?           @relation("PackageModifiedBy", fields: [modifiedBy], references: [id])
  store          Store           @relation(fields: [storeId], references: [id])
  processingPlan ProcessingPlan? @relation(fields: [processingPlanId], references: [id])

  @@index([storeId, deletedAt, status, createdAt])
  @@index([receiverPhone])
  @@index([status])
  @@index([createdAt])
  @@index([pickedAt])
  @@index([modifiedAt])
  @@index([modifiedBy])
  @@index([notificationStatus])
  @@map("packages")
}

model Dictionary {
  id        Int       @id @default(autoincrement())
  type      String    @db.VarChar(50)
  code      String    @db.VarChar(50)
  name      String    @db.VarChar(100)
  status    Int       @default(1) @db.TinyInt
  sort      Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy Int?      @map("created_by")
  updatedBy Int?      @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy Int?      @map("deleted_by")

  prescriptionSources Prescription[]   @relation("PrescriptionSource")
  processingTypes     ProcessingPlan[] @relation("ProcessingType")
  notifyPlans         ProcessingPlan[] @relation("ProcessingPlanNotifyType")

  @@unique([type, code])
  @@index([type, status, sort])
  @@map("dictionaries")
}

model Doctor {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(100)
  status    Int       @default(1) @db.TinyInt
  sort      Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy Int?      @map("created_by")
  updatedBy Int?      @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy Int?      @map("deleted_by")

  prescriptions    Prescription[]
  e6DoctorMappings E6DoctorMapping[]

  @@index([status, sort])
  @@map("doctors")
}

model Prescription {
  id               Int       @id @default(autoincrement())
  prescriptionNo   String    @unique @map("prescription_no") @db.VarChar(24)
  customerName     String    @map("customer_name") @db.VarChar(64)
  phone            String?   @db.VarChar(20)
  doctorId         Int       @map("doctor_id")
  sourceId         Int       @map("source_id")
  isExternal       Int       @default(0) @map("is_external") @db.TinyInt
  externalHospital String?   @map("external_hospital") @db.VarChar(150)
  externalDoctor   String?   @map("external_doctor") @db.VarChar(100)
  externalRemark   String?   @map("external_remark") @db.VarChar(500)
  remark           String?   @db.VarChar(500)
  totalPrice       Decimal?  @map("total_price") @db.Decimal(14, 2)
  storeId          Int       @map("store_id")
  status           Int       @default(0) @db.TinyInt
  createdBy        Int       @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  updatedBy        Int?      @map("updated_by")
  deletedAt        DateTime? @map("deleted_at")
  deletedBy        Int?      @map("deleted_by")

  doctor     Doctor                  @relation(fields: [doctorId], references: [id])
  source     Dictionary              @relation("PrescriptionSource", fields: [sourceId], references: [id])
  store      Store                   @relation(fields: [storeId], references: [id])
  creator    User                    @relation("PrescriptionCreatedBy", fields: [createdBy], references: [id])
  plans      ProcessingPlan[]
  e6Imports  E6Import[]
  attachment PrescriptionAttachment?

  @@index([phone])
  @@index([doctorId])
  @@index([sourceId])
  @@index([storeId, status, createdAt])
  @@map("prescriptions")
}

model PrescriptionAttachment {
  id             Int      @id @default(autoincrement())
  prescriptionId Int      @unique @map("prescription_id")
  originalName   String   @map("original_name") @db.VarChar(255)
  mimeType       String   @map("mime_type") @db.VarChar(100)
  fileSize       Int      @map("file_size")
  storagePath    String?  @map("storage_path") @db.VarChar(500)
  data           Bytes?   @db.LongBlob
  createdBy      Int      @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  creator      User         @relation("PrescriptionAttachmentCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([createdBy])
  @@map("prescription_attachments")
}

model ProcessingPlan {
  id                    Int       @id @default(autoincrement())
  prescriptionId        Int       @map("prescription_id")
  batchNo               Int       @map("batch_no")
  processTypeId         Int       @map("process_type_id")
  totalDose             Int       @map("total_dose")
  bagCount              Int?      @map("bag_count")
  volumeMl              Int?      @map("volume_ml")
  usageMethod           String?   @map("usage_method") @db.VarChar(200)
  takenDose             Int       @default(0) @map("taken_dose")
  remainingDose         Int       @map("remaining_dose")
  scheduleType          Int       @map("schedule_type") @db.TinyInt
  processDate           DateTime? @map("process_date")
  startDate             DateTime? @map("start_date")
  finishDate            DateTime? @map("finish_date")
  status                Int       @default(0) @db.TinyInt
  priority              Int       @default(0) @db.TinyInt
  notifyType            Int       @map("notify_type")
  notifyStatus          Int       @default(0) @map("notify_status") @db.TinyInt
  notifyTime            DateTime? @map("notify_time")
  processRemark         String?   @map("process_remark") @db.VarChar(500)
  paymentStatus         Int       @default(1) @map("payment_status") @db.TinyInt
  pickupMethod          Int       @default(0) @map("pickup_method") @db.TinyInt
  pickupCode            String?   @unique @map("pickup_code") @db.VarChar(6)
  expressAddress        String?   @map("express_address") @db.VarChar(500)
  queueOrder            Int?      @map("queue_order")
  remark                String?   @db.VarChar(500)
  createdBy             Int       @map("created_by")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  updatedBy             Int?      @map("updated_by")
  deletedAt             DateTime? @map("deleted_at")
  deletedBy             Int?      @map("deleted_by")
  storeId               Int       @map("store_id")
  planCode              String?   @unique @map("plan_code") @db.VarChar(24)
  scanToken             String?   @unique @map("scan_token") @db.VarChar(64)
  currentStage          Int?      @map("current_stage") @db.TinyInt
  dispensingCompletedAt DateTime? @map("dispensing_completed_at")
  dispensingCompletedBy Int?      @map("dispensing_completed_by")

  prescription         Prescription                  @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  processType          Dictionary                    @relation("ProcessingType", fields: [processTypeId], references: [id])
  notifyTypeDictionary Dictionary                    @relation("ProcessingPlanNotifyType", fields: [notifyType], references: [id], onDelete: Restrict)
  creator              User                          @relation("ProcessingPlanCreatedBy", fields: [createdBy], references: [id])
  store                Store                         @relation(fields: [storeId], references: [id])
  package              Package?
  e6Imports            E6Import[]
  photos               ProcessingPhoto[]
  equipmentUsages      ProcessingEquipmentUsage[]
  workflowExceptions   ProcessingWorkflowException[]

  @@unique([prescriptionId, batchNo])
  @@index([storeId, status, scheduleType, processDate])

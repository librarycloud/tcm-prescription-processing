DATABASE_URL="mysql://root:password@localhost:3306/wechat_pickup"
JWT_SECRET="replace-with-a-long-random-secret"
# Optional; defaults to JWT_SECRET when omitted. Keep stable after QR codes are printed.
PICKUP_QR_SECRET="replace-with-a-separate-random-secret"
REDIS_URL="redis://127.0.0.1:6379"
WX_APPID="wx-your-appid"
WX_SECRET="your-wechat-secret"
PORT=3000
HOST="0.0.0.0"
TRUST_PROXY="127.0.0.1,::1"
IPDB_PATH=""
UPLOAD_DIR="./uploads"
SETTINGS_ENCRYPTION_KEY="replace-with-a-32-byte-base64-key"
NODE_ENV="development"
# Used only when manually syncing the latest Android GitHub Release.
GITHUB_REPOSITORY="owner/repository"
GITHUB_TOKEN=""

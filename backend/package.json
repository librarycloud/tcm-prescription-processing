{
  "name": "tcm-prescription-backend",
  "version": "1.0.0",
  "description": "TCM Prescription Processing & Pickup Management System backend",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "prisma generate",
    "dev": "node --watch src/app.js",
    "prestart": "prisma generate",
    "start": "node src/app.js",
    "sync:android-release": "node scripts/syncAndroidRelease.mjs",
    "test": "node --test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.js",
    "storage:migrate-local": "node scripts/migrateUploadsToLocal.js"
  },
  "dependencies": {
    "@alicloud/dysmsapi20170525": "^4.6.0",
    "@alicloud/openapi-client": "^0.4.15",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^10.2.2",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.1",
    "ipdb": "^0.4.0",
    "nodemailer": "^9.0.3",
    "pino-pretty": "^13.0.0",
    "redis": "^5.10.0"
  },
  "devDependencies": {
    "prisma": "^7.9.1"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "mariadb": "3.5.3",
    "uuid": "11.1.1"
  },
  "allowScripts": {
    "@alicloud/openapi-core": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "bcrypt": true,
    "prisma": true
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
